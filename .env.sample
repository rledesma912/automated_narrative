# === 1. GENERAL & API ===
ENV=dev
API_HOST=0.0.0.0:8010
PORT=3010
SITE_TITLE="Narrative Builder (Sample)"

# === 2. LLM CONFIGURATION ===
# Providers: ollama | gemini | anthropic
LLM_PROVIDER=ollama
LLM_MODEL_TEMPERATURE=0.6

# === 3. OLLAMA SPECIFICS ===
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=mistral:latest

# Agent specific (Ollama)
DIRECTOR_TEMPERATURE=0.4
VOZ_TEMPERATURE=0.6
STATE_EXTRACTOR_MODEL=mistral:latest
STATE_EXTRACTOR_TEMPERATURE=0.3

# === 4. GEMINI (CLI) SPECIFICS ===
GEMINI_CLI_COMMAND=gemini
GEMINI_MODEL_NAME=gemini-1.5-pro-latest

# === 5. ANTHROPIC SPECIFICS ===
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# === 6. DATABASE ===
DATABASE_URL=sqlite+aiosqlite://stories.db

# === 7. PATHS & PROMPTS ===
INPUT_DIR=./input_stories
OUTPUT_DIR=./output_stories
TEMPLATE_DIR=./templates
PROMPTS_DIR=./config/prompts_generation

# Prompt filenames (inside PROMPTS_DIR)
PROMPT_FILE_SYSTEM=system.md
PROMPT_FILE_VOICE=voice.md
PROMPT_FILE_JOURNAL=journal.md

# Default story config
DEFAULT_TOTAL_ACTS=5
