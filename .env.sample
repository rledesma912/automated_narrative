# === 1. GENERAL ===
ENV=dev
API_HOST=0.0.0.0:8010
PORT=3010
SITE_TITLE="Narrative Builder (Sample)"

# === 2. LLM PROFILE OVERRIDE ===
# Los perfiles pre-configurados (provider + modelos + params por rol) viven en
# config/llm_core_definitions.yaml bajo la clave `profiles:`.
# El perfil activo se define con `active_profile:` en esa YAML.
# Esta variable pisa el valor de la YAML para experimentación rápida sin editarla.
# Valores válidos: cualquier clave bajo `profiles:` del YAML.
# LLM_PROFILE=ollama-llama31

# === 3. SECRETS ===
# API keys — nunca commitear valores reales
ANTHROPIC_API_KEY=your_api_key_here

# === 4. DATABASE ===
DATABASE_URL=sqlite+aiosqlite://stories.db

# === 5. PATHS ===
INPUT_DIR=./input_stories
OUTPUT_DIR=./output_stories
PROMPTS_DIR=./config/prompts_generation
BEATS_DEFINITION_FILE=config/llm_beats_definition.yaml

# === 6. PROMPT FILENAMES (dentro de PROMPTS_DIR) ===
PROMPT_FILE_PLANNER=planner.md
PROMPT_FILE_SYSTEM=system.md
PROMPT_FILE_VOICE=voice.md
PROMPT_FILE_JOURNAL=journal.md
