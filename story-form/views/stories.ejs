<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis Historias - Constructor de Narrativas</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Crimson+Pro:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #ffffff;
      --bg-2: #f8f7f5;
      --bg-3: #ede5d7;
      --bg-4: #e5dfd3;
      --border: #d4cdc0;
      --border-2: #c4bdb0;
      --gold: #996633;
      --gold-dim: #7a5c3a;
      --text: #2a2420;
      --text-2: #5a5a5a;
      --text-3: #8a8a80;
      --red: #d9534f;
      --success: #5cb85c;
      --radius: 6px;
      --transition: 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 62.5%;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Crimson Pro', Georgia, serif;
      font-size: 1.8rem;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 20px;
    }

    .header {
      text-align: center;
      margin-bottom: 48px;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--border);
    }

    .header-icon {
      font-size: 3.2rem;
      color: var(--gold);
      margin-bottom: 12px;
    }

    .header-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 4rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.01em;
      margin-bottom: 8px;
    }

    .header-desc {
      font-size: 1.8rem;
      color: var(--text-2);
    }

    .actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 40px;
    }

    .btn {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.7rem;
      font-weight: 700;
      padding: 11px 28px;
      border-radius: var(--radius);
      border: none;
      cursor: pointer;
      transition: all var(--transition);
      text-decoration: none;
      display: inline-block;
      letter-spacing: 0.04em;
    }

    .btn-primary {
      background: var(--gold);
      color: var(--bg);
    }

    .btn-primary:hover {
      background: #ddb96e;
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(201,168,108,0.25);
    }

    .btn-secondary {
      background: transparent;
      color: var(--text-2);
      border: 1px solid var(--border-2);
    }

    .btn-secondary:hover {
      border-color: var(--text-3);
      color: var(--text);
    }

    .stories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }

    .story-card {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      background: var(--bg-2);
      cursor: pointer;
      transition: all var(--transition);
    }

    .story-card:hover {
      border-color: var(--gold-dim);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
    }

    .story-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }

    .story-meta {
      font-size: 1.4rem;
      color: var(--text-3);
      margin-bottom: 16px;
    }

    .story-date {
      display: block;
      font-size: 1.3rem;
      color: var(--text-3);
      margin-bottom: 4px;
    }

    .story-actions {
      display: flex;
      gap: 8px;
      margin-top: 16px;
    }

    .btn-small {
      font-family: 'Crimson Pro', serif;
      font-size: 1.5rem;
      padding: 7px 14px;
      border-radius: 4px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-2);
      cursor: pointer;
      transition: all var(--transition);
      flex: 1;
      text-align: center;
    }

    .btn-small:hover {
      border-color: var(--gold-dim);
      color: var(--gold);
      background: var(--bg-3);
    }

    .btn-delete {
      color: var(--red);
      border-color: var(--red);
    }

    .btn-delete:hover {
      border-color: var(--red);
      color: var(--bg);
      background: var(--red);
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
    }

    .empty-icon {
      font-size: 3.2rem;
      color: var(--text-3);
      margin-bottom: 16px;
    }

    .empty-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.4rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 8px;
    }

    .empty-desc {
      font-size: 1.6rem;
      color: var(--text-2);
      margin-bottom: 24px;
    }

    @media (max-width: 768px) {
      .container {
        padding: 24px 16px;
      }

      .header {
        margin-bottom: 32px;
        padding-bottom: 24px;
      }

      .header-title {
        font-size: 2.8rem;
      }

      .stories-grid {
        grid-template-columns: 1fr;
      }
    }

    /* DELETE MODAL */
    .delete-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .delete-modal.active {
      display: flex;
      opacity: 1;
    }

    .delete-modal-content {
      background: var(--bg);
      border-radius: 8px;
      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.15);
      max-width: 400px;
      width: 90%;
      overflow: hidden;
      animation: slideUp 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes slideUp {
      from {
        transform: translateY(20px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    .delete-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 24px;
      border-bottom: 1px solid var(--border);
      font-family: 'Cormorant Garamond', serif;
    }

    .delete-modal-header h2 {
      font-size: 2.2rem;
      font-weight: 700;
      color: var(--text);
      margin: 0;
    }

    .delete-modal-close {
      background: none;
      border: none;
      font-size: 2.4rem;
      color: var(--text-2);
      cursor: pointer;
      padding: 0;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color var(--transition);
    }

    .delete-modal-close:hover {
      color: var(--red);
    }

    .delete-modal-body {
      padding: 24px;
      color: var(--text);
      font-size: 1.8rem;
      line-height: 1.6;
    }

    .delete-modal-body p {
      margin: 0 0 12px 0;
    }

    .delete-modal-body strong {
      font-weight: 700;
    }

    .delete-warning {
      color: var(--red);
      font-size: 1.5rem;
      font-weight: 500;
    }

    .delete-modal-footer {
      display: flex;
      gap: 12px;
      padding: 16px 24px;
      border-top: 1px solid var(--border);
      justify-content: flex-end;
    }

    .btn-delete-confirm {
      background: var(--red);
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: var(--radius);
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.7rem;
      font-weight: 700;
      cursor: pointer;
      transition: all var(--transition);
      letter-spacing: 0.02em;
    }

    .btn-delete-confirm:hover {
      background: #c0464a;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(217, 83, 79, 0.3);
    }

    @media (max-width: 480px) {
      .delete-modal-content {
        max-width: 95%;
      }

      .delete-modal-footer {
        flex-direction: column;
      }

      .delete-modal-footer .btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
<div class="container">
  <!-- HEADER -->
  <div class="header">
    <div class="header-icon">✦</div>
    <h1 class="header-title">Mis Historias</h1>
    <p class="header-desc">Gestiona y edita tus relatos</p>
  </div>

  <!-- ACTIONS -->
  <div class="actions">
    <a href="/" class="btn btn-primary">+ Nueva Historia</a>
  </div>

  <!-- STORIES GRID OR EMPTY STATE -->
  <% if (stories && stories.length > 0) { %>
    <div class="stories-grid">
      <% stories.forEach(story => {
        const date = new Date(story.created_at);
        const dateStr = date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });
      %>
        <div class="story-card">
          <h3 class="story-title"><%= story.story_name %></h3>
          <div class="story-meta">
            <span class="story-date">Creada: <%= dateStr %></span>
          </div>
          <div class="story-actions">
            <form action="/stories/<%= story.id %>/edit" method="GET" style="flex: 1;">
              <button type="submit" class="btn-small" style="width: 100%;">Editar</button>
            </form>
            <button class="btn-small btn-delete" onclick="deleteStory(<%= story.id %>, '<%= story.story_name %>'); return false;">Eliminar</button>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon">📖</div>
      <h2 class="empty-title">No hay historias aún</h2>
      <p class="empty-desc">Crea tu primer relato para comenzar</p>
      <a href="/" class="btn btn-primary">Crear Historia</a>
    </div>
  <% } %>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="delete-modal" id="deleteModal">
  <div class="delete-modal-content">
    <div class="delete-modal-header">
      <h2>Eliminar historia</h2>
      <button class="delete-modal-close" onclick="closeDeleteModal()">×</button>
    </div>
    <div class="delete-modal-body">
      <p>¿Estás seguro de que quieres eliminar <strong id="deleteStoryName"></strong>?</p>
      <p class="delete-warning">Esta acción no se puede deshacer.</p>
    </div>
    <div class="delete-modal-footer">
      <button class="btn btn-secondary" onclick="closeDeleteModal()">Cancelar</button>
      <button class="btn btn-delete-confirm" onclick="confirmDelete()">Sí, eliminar</button>
    </div>
  </div>
</div>

<script>
let pendingDeleteId = null;
let pendingDeleteName = null;

function deleteStory(storyId, storyName) {
  pendingDeleteId = storyId;
  pendingDeleteName = storyName;
  document.getElementById('deleteStoryName').textContent = `"${storyName}"`;
  document.getElementById('deleteModal').classList.add('active');
}

function closeDeleteModal() {
  document.getElementById('deleteModal').classList.remove('active');
  pendingDeleteId = null;
  pendingDeleteName = null;
}

function confirmDelete() {
  if (pendingDeleteId) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/stories/${pendingDeleteId}/delete`;
    document.body.appendChild(form);
    form.submit();
  }
}

// Close modal when clicking outside
document.getElementById('deleteModal')?.addEventListener('click', (e) => {
  if (e.target.id === 'deleteModal') {
    closeDeleteModal();
  }
});

// Close modal with Escape key
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && document.getElementById('deleteModal')?.classList.contains('active')) {
    closeDeleteModal();
  }
});
</script>
</body>
</html>
