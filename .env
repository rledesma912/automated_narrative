# Servidor
PORT=3010
SITE_TITLE=Narrative Builder

# FastAPI (NarrativeForge)
API_HOST=0.0.0.0:8010
#OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Modelos LLM
LLM_MODEL=Tohur/natsumura-storytelling-rp-llama-3.1:8b
LLM_MODEL_TEMPERATURE=0.6
DIRECTOR_TEMPERATURE=0.4
VOZ_TEMPERATURE=0.6
STATE_EXTRACTOR_MODEL=mistral:latest
STATE_EXTRACTOR_TEMPERATURE=0.3


# Rutas de directorios
OUTPUT_DIR=./output_stories
TEMPLATE_DIR=./templates
PROMPTS_DIR=./config/prompts
INPUT_DIR=./input_stories

# Nombres de archivos de prompts (ubicados en PROMPTS_DIR/generation/)
PROMPT_FILE_VOICE=voice.md
PROMPT_FILE_SYSTEM=system.md
PROMPT_FILE_JOURNAL=journal.md

# Historia (valores por defecto del formulario)
DEFAULT_TOTAL_ACTS=5

# Email (SMTP) - Configurá tu servidor de email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hrledesma@gmail.com
SMTP_PASSWORD=not_a_real_password
SMTP_FROM_EMAIL=hrledesma@gmail.com
SMTP_FROM_NAME=NarrativeForge
NOTIFICATION_EMAIL=hrledesma@gmail.com