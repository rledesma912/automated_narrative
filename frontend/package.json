{
  "name": "narrativeforge-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css",
    "watch:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles.css --watch",
    "dev": "concurrently \"npm run watch:css\" \"nodemon --watch src --ext ts --exec ts-node src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "prestart": "npm run build:css",
    "pretest": "npm run build:css",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.3",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.31",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
