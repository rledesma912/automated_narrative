# Spec-540: imagen de la UI de DEV. A diferencia de `Dockerfile` (prod), instala las
# devDependencies y corre `npm run dev` (nodemon + tailwind --watch). src/, public/
# y tailwind.config.js se montan desde el directorio de trabajo (docker-compose.dev.yml).
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json tailwind.config.js postcss.config.js ./

EXPOSE 3040

CMD ["npm", "run", "dev"]
