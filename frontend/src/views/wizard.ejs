<%
/*
 * Variables de entrada:
 *   steps:   WizardStep[]  — todos los pasos
 *   step:    WizardStep    — paso activo
 *   saved:   Record<string, string> — datos guardados en sesión para este paso
 *   isLast:  boolean
 */

const GROUP_META = {
  elenco:       { title: 'PERSONAJES',       subtitle: 'Quiénes son en la historia' },
  narrador:     { title: 'NARRADOR',         subtitle: 'Quién cuenta la historia, su nombre y tono de voz' },
  percepcion:   { title: 'PERCEPCIÓN',       subtitle: 'Qué tan confiable es lo que ve, oye y siente' },
  conocimiento: { title: 'CONOCIMIENTO',     subtitle: 'Qué sabe de lo oculto y lo sagrado' },
  lenguaje:     { title: 'LENGUAJE',         subtitle: 'Cómo habla y escribe el narrador' },
  sesgos:       { title: 'SESGOS',           subtitle: 'Qué le da miedo y en qué presta atención' },
  atmosphere:   { title: 'ATMÓSFERA',        subtitle: 'El subgénero y tono del horror' },
  escenarios:   { title: 'ESCENARIOS',       subtitle: 'Los lugares donde ocurre la historia' },
  reglas:       { title: 'REGLAS DEL MUNDO', subtitle: 'Las leyes que rigen este universo' },
  actos:        { title: 'LA TRAMA',         subtitle: 'Los 5 actos según la Pirámide de Freytag' },
};

function esc(str) {
  return String(str || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function getSavedArray(fieldName) {
  try { return JSON.parse(saved[fieldName] || '[]'); } catch { return []; }
}

const ungrouped = step.fields.filter(f => !f.group);
const seenGroups = [];
const groupedMap = {};
step.fields.filter(f => f.group).forEach(f => {
  if (!seenGroups.includes(f.group)) seenGroups.push(f.group);
  if (!groupedMap[f.group]) groupedMap[f.group] = [];
  groupedMap[f.group].push(f);
});

const CLS_INPUT = 'w-full bg-forge-surface border border-forge-border text-forge-text text-lg px-4 py-3 focus:outline-none focus:border-forge-accent transition-colors placeholder:text-forge-muted';

function fieldHtml(field) {
  const sv        = saved[field.name] || '';
  const effective = sv || field.default || '';
  const msArr     = (field.type === 'multi-select') ? getSavedArray(field.name) : [];
  const reqAttr   = field.required ? ' required' : '';
  const ph        = esc(field.placeholder || '');

  let html = '<div class="mb-5">';

  html += `<label class="block text-lg font-semibold text-forge-text mb-1">${esc(field.label)}`;
  if (field.required) html += ' <span class="text-forge-accent">*</span>';
  html += '</label>';

  if (field.subtitle) {
    html += `<p class="text-sm text-forge-muted mb-2">${esc(field.subtitle)}</p>`;
  }

  if (field.type === 'textarea') {
    html += `<textarea name="${esc(field.name)}" rows="${field.rows || 3}" placeholder="${ph}"${reqAttr} class="${CLS_INPUT} resize-none">${esc(sv)}</textarea>`;

  } else if (field.type === 'select') {
    const isStoryteller = field.name === 'storyteller_id';
    html += `<select name="${esc(field.name)}"${reqAttr} class="${CLS_INPUT}">`;
    html += `<option value="" disabled${!effective ? ' selected' : ''}>Seleccioná...</option>`;
    (Array.isArray(field.options) ? field.options : []).forEach(opt => {
      const parts = opt.split(':');
      const val   = parts[0].trim();
      const label = parts.length > 1 ? parts.slice(1).join(':').trim() : parts[0].trim();

      const sel = effective === opt ? ' selected' : '';
      let displayLabel;
      if (isStoryteller) {
        const idx = val.replace('protagonista_', '');
        displayLabel = `Personaje ${idx}`;
      } else {
        displayLabel = label;
      }
      html += `<option value="${esc(opt)}"${sel}>${displayLabel}</option>`;
    });
    html += '</select>';

  } else if (field.type === 'radio') {
    html += '<div class="space-y-2 mt-2">';
    (Array.isArray(field.options) ? field.options : []).forEach(opt => {
      const chk = effective === opt ? ' checked' : '';
      html += '<label class="flex items-center gap-3 cursor-pointer">';
      html += `<input type="radio" name="${esc(field.name)}" value="${esc(opt)}"${chk} class="w-4 h-4 accent-forge-accent cursor-pointer" />`;
      html += `<span class="text-base text-forge-text">${esc(opt)}</span>`;
      html += '</label>';
    });
    html += '</div>';

  } else if (field.type === 'multi-select') {
    html += '<div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mt-2">';
    (Array.isArray(field.options) ? field.options : []).forEach(opt => {
      const parts = opt.split(':');
      const label = parts.length > 1 ? parts.slice(1).join(':').trim() : parts[0].trim();
      const chk = msArr.includes(opt) ? ' checked' : '';
      html += '<label class="flex items-center gap-2 cursor-pointer">';
      html += `<input type="checkbox" name="${esc(field.name)}" value="${esc(opt)}"${chk} class="w-4 h-4 accent-forge-accent cursor-pointer" />`;
      html += `<span class="text-base text-forge-text">${label}</span>`;
      html += '</label>';
    });
    html += '</div>';

  } else {
    html += `<input type="text" name="${esc(field.name)}" value="${esc(sv)}" placeholder="${ph}"${reqAttr} class="${CLS_INPUT}" />`;
  }

  if (field.note) {
    html += `<p class="text-xs text-forge-muted mt-2 italic">${esc(field.note)}</p>`;
  }
  if (field.hint) {
    html += `<p class="text-xs text-forge-muted mt-1 italic">${esc(field.hint)}</p>`;
  }

  html += '</div>';
  return html;
}

// ── Helpers para grupos dinámicos ────────────────────────────────────────────
function groupFieldsByIndex(fields, pattern) {
  // Agrupa fields por índice extraído del nombre según pattern
  const cards = {};
  fields.forEach(f => {
    const m = f.name.match(pattern);
    if (m) {
      const idx = m[1];
      if (!cards[idx]) cards[idx] = [];
      cards[idx].push(f);
    }
  });
  return cards;
}

function hasCardData(fields) {
  return fields.some(f => {
    const v = saved[f.name];
    if (!v) return false;
    if (f.type === 'multi-select') {
      try { return JSON.parse(v).length > 0; } catch { return false; }
    }
    return v.trim() !== '';
  });
}
%>

<div class="w-[85vw] max-w-5xl mx-auto">

  <%/* ── Stepper header ─────────────────────────────── */%>
  <div class="flex items-center gap-0 mb-10 overflow-x-auto pb-2">
    <% steps.forEach((s, i) => { %>
      <%
        const done   = s.number < step.number;
        const active = s.number === step.number;
        const circleClass = active
          ? 'bg-forge-accent text-forge-text border-forge-accent'
          : done
            ? 'bg-transparent text-forge-accent border-forge-accent'
            : 'bg-transparent text-forge-muted border-forge-border';
        const labelClass = active ? 'text-forge-text' : done ? 'text-forge-accent' : 'text-forge-muted';
      %>
      <div class="flex flex-col items-center shrink-0">
        <% if (done) { %>
          <a href="/generar/paso/<%= s.number %>"
             class="w-8 h-8 rounded-full border-2 flex items-center justify-center text-xs font-bold <%= circleClass %> hover:opacity-70 transition-opacity">
            <i data-lucide="check" class="w-3 h-3"></i>
          </a>
        <% } else { %>
          <div class="w-8 h-8 rounded-full border-2 flex items-center justify-center text-xs font-bold <%= circleClass %>">
            <%= s.number %>
          </div>
        <% } %>
        <span class="text-xs mt-1 <%= labelClass %> whitespace-nowrap"><%= s.title %></span>
      </div>
      <% if (i < steps.length - 1) { %>
        <div class="h-px flex-1 min-w-4 mx-2 mt-[-14px] <%= s.number < step.number ? 'bg-forge-accent' : 'bg-forge-border' %>"></div>
      <% } %>
    <% }); %>
  </div>

  <%/* ── Título + Subtítulo del paso ─────────────────── */%>
  <h2 class="heading-forge-lg mb-1"><%= step.title %></h2>
  <% if (step.subtitle) { %>
    <p class="text-forge-muted-caps mb-8"><%= step.subtitle %></p>
  <% } else { %>
    <div class="mb-6"></div>
  <% } %>

  <%/* ── Formulario ───────────────────────────────────── */%>
  <form method="POST" action="/generar/paso/<%= step.number %>" class="space-y-6">

    <%/* -- Campos sin grupo */%>
    <% ungrouped.forEach(field => { %>
      <%- fieldHtml(field) %>
    <% }); %>

    <%/* -- Grupos como cards */%>
    <% seenGroups.forEach(groupName => { %>
      <% const meta = GROUP_META[groupName] || { title: groupName.toUpperCase(), subtitle: '' }; %>

      <% if (groupName === 'elenco') { %>
        <%
          const protagCards = groupFieldsByIndex(groupedMap['elenco'], /^protagonista_(\d+)_/);
          const protagIndices = Object.keys(protagCards).sort((a,b) => Number(a)-Number(b));
          const MAX_PROTAGONISTAS = 5;
        %>
        <%- include('partials/wizard_card_list', {
          meta, indices: protagIndices, cards: protagCards, saved,
          itemLabel: 'PERSONAJE',
          addLabel: 'Agregar personaje',
          maxLabel: 'Máximo ' + MAX_PROTAGONISTAS + ' personajes',
          iconAdd: 'user-plus',
          addHandler: 'addPersonaje()',
          deleteHandler: 'askDeletePersonaje',
          groupContainerId: 'elenco-group',
          cardIdPrefix: 'personaje-card',
          labelIdPrefix: 'personaje-label',
          deleteBtnIdPrefix: 'personaje-delete-btn',
          addBtnId: 'btn-add-personaje',
          msgMaxId: 'msg-max-personajes',
          fieldNamePrefix: 'protagonista',
          hasCardData, fieldHtml, esc,
        }) %>

      <% } else if (groupName === 'escenarios') { %>
        <%
          const scenCards = groupFieldsByIndex(groupedMap['escenarios'], /^scenario_(\d+)_/);
          const scenIndices = Object.keys(scenCards).sort((a,b) => Number(a)-Number(b));
          const MAX_ESCENARIOS = 4;
        %>
        <%- include('partials/wizard_card_list', {
          meta, indices: scenIndices, cards: scenCards, saved,
          itemLabel: 'ESCENARIO',
          addLabel: 'Agregar escenario',
          maxLabel: 'Máximo ' + MAX_ESCENARIOS + ' escenarios',
          iconAdd: 'map-pin',
          addHandler: 'addScenario()',
          deleteHandler: 'askDeleteScenario',
          groupContainerId: 'escenarios-group',
          cardIdPrefix: 'scenario-card',
          deleteBtnIdPrefix: 'scenario-delete-btn',
          addBtnId: 'btn-add-scenario',
          msgMaxId: 'msg-max-escenarios',
          hasCardData, fieldHtml, esc,
        }) %>

      <% } else if (groupName === 'reglas') { %>
        <%
          const ruleCards = groupFieldsByIndex(groupedMap['reglas'], /^rule_(\d+)_/);
          const ruleIndices = Object.keys(ruleCards).sort((a,b) => Number(a)-Number(b));
          const MAX_REGLAS = 7;
        %>
        <%- include('partials/wizard_card_list', {
          meta, indices: ruleIndices, cards: ruleCards, saved,
          itemLabel: 'REGLA',
          addLabel: 'Agregar regla',
          maxLabel: 'Máximo ' + MAX_REGLAS + ' reglas',
          iconAdd: 'plus-circle',
          addHandler: 'addRule()',
          deleteHandler: 'askDeleteRule',
          groupContainerId: 'reglas-group',
          cardIdPrefix: 'rule-card',
          deleteBtnIdPrefix: 'rule-delete-btn',
          addBtnId: 'btn-add-rule',
          msgMaxId: 'msg-max-reglas',
          hasCardData, fieldHtml, esc,
        }) %>

      <% } else { %>
        <div class="card-forge !p-6 space-y-5">
          <div class="border-b border-forge-border pb-3">
            <h3 class="text-forge-muted-caps font-bold"><%= meta.title %></h3>
            <p class="text-sm text-forge-muted mt-1"><%= meta.subtitle %></p>
          </div>
          <% groupedMap[groupName].forEach(field => { %>
            <%- fieldHtml(field) %>
          <% }); %>
        </div>
      <% } %>

    <% }); %>

    <%/* ── Navegación ────────────────────────────────── */%>
    <div class="flex items-center justify-between pt-8 border-t border-forge-border">
      <% if (step.number > 1) { %>
        <a href="/generar/paso/<%= step.number - 1 %>"
           class="btn-forge-outline !px-0 !border-none">
          <i data-lucide="arrow-left" class="w-4 h-4"></i> Anterior
        </a>
      <% } else { %>
        <span></span>
      <% } %>

      <button type="submit" class="btn-forge !px-8 !py-3 !text-sm">
        <% if (isLast) { %>
          <i data-lucide="save" class="w-4 h-4"></i> Guardar y revisar
        <% } else { %>
          Siguiente <i data-lucide="arrow-right" class="w-4 h-4"></i>
        <% } %>
      </button>
    </div>
  </form>
</div>

<%/* ── Modal de confirmación de eliminación ────────────────────────────── */%>
<div id="delete-modal"
     class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50">
  <div class="card-forge !p-6 max-w-sm w-full mx-4">
    <h3 class="text-forge-muted-caps font-bold mb-3">Confirmar eliminación</h3>
    <p id="delete-modal-msg" class="text-forge-body !text-sm mb-5"></p>
    <div class="flex gap-3 justify-end">
      <button type="button" onclick="closeDeleteModal()" class="btn-forge-outline">
        Cancelar
      </button>
      <button type="button" id="delete-modal-confirm"
              class="btn-forge-outline !bg-red-900 !text-red-100 !border-red-800 hover:!bg-red-800">
        Eliminar
      </button>
    </div>
  </div>
</div>

<%/* Spec-318 §9.C — script extraído a /js/wizard.js. STEP_NUM se inyecta abajo. */%>
<script>
  window.STEP_NUM = <%= step.number %>;
</script>
<script src="/js/wizard.js" defer></script>

