<div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-10 border-b border-forge-border pb-6">
    <div>
      <h2 class="font-serif text-4xl text-forge-accent"><%= story.title %></h2>
      <p class="text-forge-muted text-sm uppercase tracking-widest mt-2">Versión Markdown Exportada</p>
    </div>
    <div class="flex gap-4">
      <% if (fileMissing) { %>
        <div class="flex items-center gap-2 px-4 py-2 bg-red-950/30 border border-red-900/50 text-red-400 text-sm">
          <i data-lucide="alert-triangle" class="w-4 h-4"></i>
          Archivo no encontrado
        </div>
        <button onclick="desvincularRegistro('<%= story.id %>')"
                class="px-6 py-2 border border-yellow-600/50 text-yellow-400 text-sm uppercase tracking-widest hover:bg-yellow-950/20 flex items-center gap-2 transition-colors">
          <i data-lucide="link-off" class="w-4 h-4"></i> Desvincular registro
        </button>
      <% } else { %>
        <a href="/historia/<%= story.id %>/descargar-markdown"
           class="px-6 py-2 border border-forge-border text-forge-muted text-sm uppercase tracking-widest hover:text-forge-text flex items-center gap-2 transition-colors">
          <i data-lucide="download" class="w-4 h-4"></i> Descargar
        </a>

        <button hx-get="/modales/confirmar-borrar-markdown/<%= story.id %>"
                hx-target="body"
                hx-swap="beforeend"
                class="px-6 py-2 border border-red-900/50 text-red-400 text-sm uppercase tracking-widest hover:bg-red-950/20 flex items-center gap-2 transition-colors">
          <i data-lucide="file-minus" class="w-4 h-4"></i> Eliminar Archivo
        </button>
      <% } %>

      <a href="/galeria"
         class="px-6 py-2 bg-forge-accent text-forge-text text-sm uppercase tracking-widest hover:opacity-80 flex items-center gap-2 transition-opacity">
        <i data-lucide="library" class="w-4 h-4"></i> Galería
      </a>
    </div>
  </div>

  <% if (fileMissing) { %>
    <div class="bg-forge-surface border border-red-900/30 p-12 shadow-2xl text-center">
      <i data-lucide="file-x" class="w-16 h-16 mx-auto mb-6 text-red-500 opacity-50"></i>
      <p class="text-forge-text text-xl font-serif">El archivo Markdown no se encontró en el servidor.</p>
      <p class="text-forge-muted text-sm mt-4">Puedes desvincular el registro para limpiar la referencia a este archivo.</p>
    </div>
  <% } else { %>
    <div class="bg-forge-surface border border-forge-border p-12 shadow-2xl">
      <div class="prose prose-invert prose-stone max-w-none font-serif text-forge-text text-xl leading-relaxed whitespace-pre-wrap">
<%= content %>
      </div>
    </div>
  <% } %>

  <div class="mt-8 text-center text-forge-muted text-xs uppercase tracking-widest">
    Fin del relato · NarrativeForge
  </div>
</div>

<script>
  async function desvincularRegistro(storyId) {
    if (!confirm("¿Desvincular el registro del archivo Markdown? La historia y su configuración se conservarán.")) return;
    try {
      const res = await fetch(`/internal/historia/${storyId}/file-path`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ file_path: null }),
      });
      if (!res.ok) throw new Error("Error al desvincular");
      window.location.href = `/historia/${storyId}`;
    } catch {
      alert("No se pudo desvincular el registro.");
    }
  }
</script>
