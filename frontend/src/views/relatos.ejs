<%
/*
 * Variables de entrada:
 *   story: { id, title, ... } // La historia principal
 *   relatos: [
 *     { id, content, title, created_at, ... }, // Cada relato generado
 *     // ... más relatos
 *   ]
 */
%>
<div class="max-w-5xl mx-auto">
  <a href="/galeria" class="text-sm text-forge-muted hover:text-forge-accent flex items-center gap-2 mb-4">
    <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver a Galería
  </a>
  <h2 class="font-serif text-3xl text-forge-accent mb-2">Relatos de <%= story.title || 'Sin título' %></h2>
  <p class="text-forge-muted text-sm uppercase tracking-widest mb-12">Explora las diferentes versiones generadas para esta historia.</p>

  <% if (!relatos || relatos.length === 0) { %>
    <div class="card-forge !p-12 text-center text-forge-muted">
      <i data-lucide="notebook" class="w-12 h-12 mx-auto mb-4 text-forge-accent"></i>
      <p class="text-forge-body">No hay relatos generados aún para esta historia.</p>
    </div>
  <% } else { %>
    <div class="border-b border-forge-border mb-6">
      <div class="flex items-center gap-2 overflow-x-auto pb-3">
        <% relatos.forEach(function(relato, index) { %>
          <%
            const displayTitle = relato.title || `Relato ${index + 1}`;
            const createdAt = new Date(relato.created_at || Date.now()).toLocaleString('es-AR', {
              day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false
            });
          %>
          <button
            type="button"
            data-relato-tab="<%= relato.id %>"
            class="relato-tab btn-forge-outline !text-left !block whitespace-nowrap"
          >
            <span class="block font-medium"><%= displayTitle %></span>
            <span class="block text-[10px] opacity-70 tracking-widest"><%= createdAt %></span>
          </button>
        <% }); %>
      </div>
    </div>

    <% relatos.forEach(function(relato, index) { %>
      <%- include('partials/relato_panel', {
        story,
        relato,
        displayTitle: relato.title || `Relato ${index + 1}`,
        isActive: index === 0,
      }) %>
    <% }); %>
  <% } %>
</div>

<%/* Spec-318 §9.C — script extraído a /js/relatos.js. Ver el patrón de streaming-room. */%>
<script src="/js/relatos.js?v=<%= locals.assetVersion || '' %>" defer></script>
