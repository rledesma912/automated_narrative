<%
/*
 * Variables de entrada:
 *   story: { id, title, ... } // La historia principal
 *   relatos: [
 *     { id, content, title, created_at, ... }, // Cada relato generado
 *     // ... más relatos
 *   ]
 */
%>
<%/* Spec-630 B16: «El relato» es el paso 4 del asistente: la misma barra fija con
     los pasos, para volver a «Los actos» (antes solo se podía ir a la galería). */%>
<div class="asistente-barra">
  <%- include('asistente/_cabecera', { state: { story_id: story.id, status: story.status }, pasoActual: 'relato' }) %>
</div>
<div class="max-w-5xl mx-auto">
  <h2 class="font-serif text-3xl text-forge-accent mb-2">Relatos de <%= story.title || 'Sin título' %><% if (story.structure === 'corto') { %> <span class="chip-forge chip-forge--info align-middle" data-corto>Corto</span><% } %></h2>
  <p class="text-forge-muted text-sm uppercase tracking-widest mb-12">Cada vez que la IA escribe esta historia queda una versión. Acá están todas.</p>

  <% if (!relatos || relatos.length === 0) { %>
    <div class="card-forge !p-12 text-center text-forge-muted">
      <i data-lucide="notebook" class="w-12 h-12 mx-auto mb-4 text-forge-accent"></i>
      <p class="text-forge-body">Todavía no hay relatos de esta historia.</p>
    </div>
  <% } else { %>
    <%/* Spec-630 B15: todas las acciones juntas, arriba: «Regenerar historia» (B19: una
         versión nueva; Spec-660: pregunta acá con el tiempo estimado) y las de la versión elegida. */%>
    <section class="card-forge !p-5 mb-6 flex flex-wrap items-center justify-between gap-4" data-relato-acciones>
      <div class="flex flex-wrap items-center gap-3">
        <% relatos.forEach(function(relato, index) { %>
          <%- include('partials/relato_acciones', { story, relato, isActive: index === 0, regenerating: null, oob: false }) %>
        <% }); %>
      </div>
      <button type="button" class="btn-forge-sm" data-escribir-relato data-version-nueva
              data-generation-trigger data-story-id="<%= story.id %>"
              data-estimado="<%= (locals.estimateLabels && locals.estimateLabels.full_generation) || '' %>">
        <i data-lucide="refresh-cw" class="w-4 h-4"></i> Regenerar historia
      </button>
    </section>

    <div class="border-b border-forge-border mb-6">
      <div class="flex items-center gap-2 overflow-x-auto pb-3">
        <% relatos.forEach(function(relato, index) { %>
          <%
            // Spec-630 B13: el título es el de la historia (ya está arriba); la pestaña dice solo la fecha.
            const createdAt = new Date(relato.created_at || Date.now()).toLocaleString('es-AR', {
              day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false,
              timeZone: 'America/Argentina/Buenos_Aires', // el contenedor corre en UTC
            }).replace(',', '');
          %>
          <button
            type="button"
            data-relato-tab="<%= relato.id %>"
            class="relato-tab btn-forge-outline !text-left !block whitespace-nowrap"
          >
            <span class="block font-medium">Versión del <%= createdAt %></span>
            <%/* Spec-630 B21: qué versión tiene el guion para el video. */%>
            <% if (relato.hasVideoScript) { %>
              <span class="chip-forge chip-forge--info mt-1" data-con-guion>Con guion</span>
            <% } %>
          </button>
        <% }); %>
      </div>
    </div>

    <% relatos.forEach(function(relato, index) { %>
      <%- include('partials/relato_panel', {
        story,
        relato,
        isActive: index === 0,
      }) %>
    <% }); %>
  <% } %>
</div>

<%/* Spec-318 §9.C — script extraído a /js/relatos.js. Ver el patrón de streaming-room. */%>
<%- include('partials/ia_modal') %>
<script src="/js/ia-modal.js?v=<%= locals.assetVersion || '' %>" defer></script>
<script src="/js/relatos.js?v=<%= locals.assetVersion || '' %>" defer></script>
