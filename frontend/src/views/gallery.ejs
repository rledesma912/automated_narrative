<%
/* User update (Spec-213): Vuelven los estados completos y escala aumentada */
function renderStatusLabel(s) {
  const labels = {
    draft:      { text: 'Borrador',   cls: 'text-yellow-500' },
    processing: { text: 'Generando',  cls: 'text-blue-400' },
    completed:  { text: 'Completada', cls: 'text-green-500' },
    failed:     { text: 'Error',      cls: 'text-red-500' },
  };
  const sl = labels[s.status] || labels['draft'];
  return `<span class="text-xs font-bold uppercase tracking-widest shrink-0 ${sl.cls}">${sl.text}</span>`;
}
%>
<div class="max-w-4xl mx-auto">
  <h2 class="font-serif text-3xl text-forge-accent mb-2">Galería</h2>
  <p class="text-forge-muted text-sm uppercase tracking-widest mb-12">Historias guardadas y generadas</p>

  <% if (!stories || stories.length === 0) { %>
    <div class="border border-forge-border bg-forge-surface p-12 text-center text-forge-muted text-base">
      <i data-lucide="library" class="w-12 h-12 mx-auto mb-4 text-forge-accent"></i>
      <p>Todavía no hay historias. <a href="/generar" class="text-forge-accent hover:opacity-70">Crear una</a></p>
    </div>
  <% } else { %>
    <div class="space-y-6">
      <% stories.forEach(function(s) { %>
        <%
          const date = new Date(s.created_at).toLocaleString('es-AR', {
            day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false
          });
        %>
        <div class="border border-forge-border bg-forge-surface p-8 shadow-lg hover:border-forge-accent/30 transition-colors">
          <div class="flex items-start justify-between gap-4 mb-6">
            <div>
              <a href="/historia/<%= s.id %>" class="group">
                <h3 class="text-xl font-semibold text-forge-text group-hover:text-forge-accent transition-colors">
                  <%= s.title || 'Sin título' %>
                </h3>
              </a>
              <p class="text-sm text-forge-muted mt-1">
                <% if (s.atmosfera) { %><%= s.atmosfera %> · <% } %><%= date %>
              </p>
            </div>
            <%- renderStatusLabel(s) %>
          </div>

          <div class="flex items-center gap-6 flex-wrap">
            <%/* Markdown / Exportar — verificado vía HTMX para detectar archivos borrados */%>
            <% if (s.file_path || s.status === 'completed') { %>
              <span hx-get="/internal/historia/<%= s.id %>/markdown-check"
                    hx-trigger="load"
                    hx-swap="outerHTML">
              </span>
            <% } %>

            <% if (s.status !== 'processing') { %>
              <a href="/generar/cargar/<%= s.id %>"
                 class="text-sm text-forge-accent hover:opacity-70 flex items-center gap-2">
                <i data-lucide="edit-3" class="w-4 h-4"></i> Editar
              </a>

              <% if (s.status === 'completed') { %>
                <form method="POST" action="/historia/<%= s.id %>/generar" class="inline">
                  <button type="submit"
                          class="text-sm text-forge-accent hover:opacity-70 flex items-center gap-2 bg-transparent border-none cursor-pointer p-0">
                    <i data-lucide="refresh-cw" class="w-4 h-4"></i> Regenerar
                  </button>
                </form>
              <% } else { %>
                <form method="POST" action="/historia/<%= s.id %>/generar" class="inline">
                  <button type="submit"
                          class="text-sm text-forge-accent hover:opacity-70 flex items-center gap-2 bg-transparent border-none cursor-pointer p-0">
                    <i data-lucide="zap" class="w-4 h-4"></i>
                    <%= s.status === 'failed' ? 'Reintentar' : 'Generar' %>
                  </button>
                </form>
              <% } %>

              <% if (s.status === 'failed') { %>
                <a href="/generar/stream/<%= s.id %>"
                   class="text-sm text-forge-muted hover:text-forge-accent flex items-center gap-2">
                  <i data-lucide="book-open" class="w-4 h-4"></i> Ver avance
                </a>
              <% } %>
            <% } else { %>
              <a href="/generar/stream/<%= s.id %>"
                 class="text-sm text-blue-400 hover:opacity-70 flex items-center gap-2">
                <i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Ver generación activa
              </a>
            <% } %>

            <button hx-get="/modales/confirmar-borrar/<%= s.id %>"
                    hx-target="body"
                    hx-swap="beforeend"
                    class="text-sm text-red-400 hover:opacity-70 flex items-center gap-2 bg-transparent border-none cursor-pointer p-0 ml-auto">
              <i data-lucide="trash-2" class="w-4 h-4"></i> Eliminar
            </button>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
