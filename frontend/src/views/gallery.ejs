<%
/* User update (Spec-213): Vuelven los estados completos y escala aumentada */
function renderStatusLabel(s) {
  const labels = {
    draft:      { text: 'Borrador',   cls: '!text-yellow-500 !border-yellow-500/30 !bg-yellow-500/10' },
    processing: { text: 'Generando',  cls: '!text-blue-400 !border-blue-400/30 !bg-blue-400/10' },
    completed:  { text: 'Completada', cls: '!text-green-500 !border-green-500/30 !bg-green-500/10' },
    failed:     { text: 'Error',      cls: '!text-red-500 !border-red-500/30 !bg-red-500/10' },
  };
  const sl = labels[s.status] || labels['draft'];
  return `<span class="badge-forge ${sl.cls}">${sl.text}</span>`;
}
%>
<div class="max-w-4xl mx-auto">
  <h2 class="heading-forge-lg mb-2">Galería</h2>
  <p class="text-forge-muted-caps mb-12">Historias guardadas y generadas</p>

  <% if (!stories || stories.length === 0) { %>
    <div class="card-forge !p-12 text-center text-forge-muted">
      <i data-lucide="library" class="w-12 h-12 mx-auto mb-4 text-forge-accent"></i>
      <p class="text-forge-body">Todavía no hay historias. <a href="/generar" class="text-forge-accent hover:opacity-70">Crear una</a></p>
    </div>
  <% } else { %>
    <div class="space-y-6">
      <% stories.forEach(function(s) { %>
        <%
          const date = new Date(s.created_at).toLocaleString('es-AR', {
            day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false
          });
        %>
        <div class="card-forge hover:!border-forge-accent/50">
          <div class="flex items-start justify-between gap-4 mb-6">
            <div>
              <a href="/historia/<%= s.id %>" class="group">
                <h3 class="text-xl font-semibold text-forge-text group-hover:text-forge-accent transition-colors">
                  <%= s.title || 'Sin título' %>
                </h3>
              </a>
              <p class="text-sm text-forge-muted mt-1">
                <% if (s.atmosfera) { %><%= s.atmosfera %> · <% } %><%= date %>
              </p>
            </div>
            <%- renderStatusLabel(s) %>
          </div>

          <div class="flex items-center gap-6 flex-wrap">
            <% if (s.status === 'processing') { %>
              <a href="/generar/stream/<%= s.id %>"
                 class="btn-forge-outline !px-0 !border-none">
                <i data-lucide="eye" class="w-4 h-4"></i> Ver avance
              </a>
              <span class="text-xs text-forge-muted italic">Generación en curso...</span>
            <% } else { %>
              <a href="/generar/cargar/<%= s.id %>"
                 class="btn-forge-outline !px-0 !border-none">
                <i data-lucide="edit-3" class="w-4 h-4"></i> Editar
              </a>

              <% if (s.status === 'completed') { %>
                <form method="POST" action="/historia/<%= s.id %>/generar" class="inline">
                  <button type="submit"
                          class="btn-forge-outline !px-0 !border-none bg-transparent cursor-pointer">
                    <i data-lucide="refresh-cw" class="w-4 h-4"></i> Regenerar
                  </button>
                </form>
                <a href="/historia/<%= s.id %>/relatos"
                   class="btn-forge-outline !px-0 !border-none">
                  <i data-lucide="book-open" class="w-4 h-4"></i> Ver Relato
                </a>
              <% } else if (s.status === 'failed') { %>
                <form method="POST" action="/historia/<%= s.id %>/generar" class="inline">
                  <button type="submit"
                          class="btn-forge-outline !px-0 !border-none bg-transparent cursor-pointer">
                    <i data-lucide="zap" class="w-4 h-4"></i> Reintentar
                  </button>
                </form>
                <a href="/generar/stream/<%= s.id %>"
                   class="btn-forge-outline !px-0 !border-none !text-forge-muted hover:!text-forge-accent">
                  <i data-lucide="book-open" class="w-4 h-4"></i> Ver avance
                </a>
              <% } else { %>
                <form method="POST" action="/historia/<%= s.id %>/generar" class="inline">
                  <button type="submit"
                          class="btn-forge-outline !px-0 !border-none bg-transparent cursor-pointer">
                    <i data-lucide="zap" class="w-4 h-4"></i> Generar
                  </button>
                </form>
              <% } %>

              <button
                type="button"
                hx-get="/modales/confirmar-borrar/<%= s.id %>"
                hx-target="#modal-slot"
                hx-swap="innerHTML"
                class="btn-forge-outline !px-0 !border-none !text-red-400 hover:!text-red-300 bg-transparent cursor-pointer"
              >
                <i data-lucide="trash-2" class="w-4 h-4"></i> Eliminar
              </button>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
<div id="modal-slot"></div>
