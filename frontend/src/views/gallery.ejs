<%
/* User update (Spec-213): Vuelven los estados completos y escala aumentada */
function renderStatusLabel(s) {
  /* Spec-550 H9: el estado es un chip. */
  const labels = {
    draft:      { text: 'Borrador',   cls: 'chip-forge--parcial' },
    processing: { text: 'Generando',  cls: 'chip-forge--info' },
    completed:  { text: 'Completada', cls: 'chip-forge--cumple' },
    failed:     { text: 'Error',      cls: 'chip-forge--falta' },
  };
  const sl = labels[s.status] || labels['draft'];
  return `<span class="chip-forge ${sl.cls}">${sl.text}</span>`;
}
%>
<div class="max-w-4xl mx-auto">
  <h2 class="heading-forge-lg mb-2">Mis historias</h2>
  <p class="text-forge-muted-caps mb-12">Las que empezaste y las que ya tienen relato</p>

  <% if (!stories || stories.length === 0) { %>
    <div class="card-forge !p-12 text-center text-forge-muted">
      <i data-lucide="library" class="w-12 h-12 mx-auto mb-4 text-forge-accent"></i>
      <p class="text-forge-body">Todavía no hay historias. <a href="/nuevo" class="text-forge-accent hover:opacity-70">Contá la primera</a></p>
    </div>
  <% } else { %>
    <%/* Spec-460: se recarga solo (generation-guard.js) cuando un job empieza o termina. */%>
    <div id="gallery-list" data-jobs-live class="space-y-6">
      <% stories.forEach(function(s) { %>
        <%
          const date = new Date(s.created_at).toLocaleString('es-AR', {
            day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false,
            timeZone: 'America/Argentina/Buenos_Aires', // el contenedor corre en UTC
          });
        %>
        <%/* Spec-460 §2.5: la historia recién guardada llega resaltada (?guardada=<id>). */%>
        <div class="card-forge hover:!border-forge-accent/50 <%= (typeof savedId !== 'undefined' && savedId === s.id) ? 'card-forge-active' : '' %>"
             data-story-card="<%= s.id %>">
          <div class="flex items-start justify-between gap-4 mb-6">
            <div>
              <h3 class="text-xl font-semibold text-forge-text">
                <%= s.title || 'Sin título' %>
              </h3>
              <p class="text-sm text-forge-muted mt-1">
                <% if (s.atmosfera) { %><%= s.atmosfera %> · <% } %><%= date %>
              </p>
            </div>
            <div class="flex flex-wrap justify-end gap-2">
              <%/* Spec-650: los relatos cortos (~7 min) se marcan; el largo es el de siempre. */%>
              <% if (s.structure === 'corto') { %><span class="chip-forge chip-forge--info" data-corto>Corto</span><% } %>
              <%- renderStatusLabel(s) %>
            </div>
          </div>

          <%/* Spec-630: la tarjeta es para entrar (B12: sin «Vista»; B14: sin generar a ciegas:
               se escribe desde «Los actos» o desde «El relato»). */%>
          <div class="flex items-center gap-3 flex-wrap">
            <% if (s.status === 'processing') { %>
              <a href="/generar/stream/<%= s.id %>"
                 class="btn-forge-outline-sm">
                <i data-lucide="eye" class="w-4 h-4"></i> Ver avance
              </a>
              <span class="text-xs text-forge-muted italic" data-job-progress="<%= s.id %>">Generación en curso...</span>
            <% } else { %>
              <a href="<%= rutas.editarHref(s.id) %>"
                 class="btn-forge-outline-sm">
                <i data-lucide="edit-3" class="w-4 h-4"></i> Editar
              </a>

              <% if (s.status === 'completed') { %>
                <a href="/historia/<%= s.id %>/relatos"
                   class="btn-forge-outline-sm">
                  <i data-lucide="book-open" class="w-4 h-4"></i> Ver relato
                </a>
                <%/* Spec-610: acceso directo al guion para el video (la última versión que lo tiene). */%>
                <% if (s.video_narrative_id) { %>
                  <a href="/historia/<%= s.id %>/relatos/<%= s.video_narrative_id %>/video"
                     class="btn-forge-outline-sm" data-para-el-video="<%= s.video_narrative_id %>">
                    <i data-lucide="clapperboard" class="w-4 h-4"></i> Para el video
                  </a>
                <% } else { %>
                  <%/* Spec-630 B21: que se note qué falta, no solo qué hay. */%>
                  <span class="chip-forge" data-sin-guion>Sin guion para el video</span>
                <% } %>
              <% } else if (s.status === 'failed') { %>
                <a href="/generar/stream/<%= s.id %>"
                   class="btn-forge-outline-sm">
                  <i data-lucide="book-open" class="w-4 h-4"></i> Ver avance
                </a>
              <% } %>

              <button
                type="button"
                hx-get="/modales/confirmar-borrar/<%= s.id %>"
                hx-target="#modal-slot"
                hx-swap="innerHTML"
                class="btn-forge-outline-danger-sm"
              >
                <i data-lucide="trash-2" class="w-4 h-4"></i> Eliminar
              </button>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
<div id="modal-slot"></div>
