<%
/*
 * Variables de entrada:
 *   stories: Array<{ id, title, status, created_at, atmosfera }>
 */
const STATUS_LABEL = {
  draft:      { text: 'Borrador',   cls: 'text-yellow-400 border-yellow-800' },
  pending:    { text: 'En cola',    cls: 'text-forge-muted border-forge-border' },
  processing: { text: 'Generando', cls: 'text-blue-400 border-blue-800' },
  completed:  { text: 'Completa',  cls: 'text-green-400 border-green-800' },
  failed:     { text: 'Error',     cls: 'text-red-400 border-red-800' },
};
%>
<div class="max-w-3xl">
  <h2 class="font-serif text-2xl text-forge-accent mb-1">Galería</h2>
  <p class="text-forge-muted text-xs uppercase tracking-widest mb-10">Historias guardadas y generadas</p>

  <% if (!stories || stories.length === 0) { %>
    <div class="border border-forge-border bg-forge-surface p-8 text-center text-forge-muted text-sm">
      <i data-lucide="library" class="w-8 h-8 mx-auto mb-3 text-forge-accent"></i>
      <p>Todavía no hay historias. <a href="/generar" class="text-forge-accent hover:opacity-70">Crear una</a></p>
    </div>
  <% } else { %>
    <div class="space-y-4">
      <% stories.forEach(function(s) { %>
        <%
          const sl = STATUS_LABEL[s.status] || STATUS_LABEL['pending'];
          const date = new Date(s.created_at).toLocaleDateString('es-AR', {
            day: '2-digit', month: '2-digit', year: 'numeric'
          });
        %>
        <div class="border border-forge-border bg-forge-surface p-5">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <h3 class="text-base font-semibold text-forge-text"><%= s.title || 'Sin título' %></h3>
              <p class="text-xs text-forge-muted mt-0.5">
                <% if (s.atmosfera) { %><%= s.atmosfera %> · <% } %><%= date %>
              </p>
            </div>
            <span class="px-2 py-0.5 text-xs border rounded shrink-0 <%= sl.cls %>">
              <%= sl.text %>
            </span>
          </div>

          <div class="flex items-center gap-3 flex-wrap">
            <a href="/historia/<%= s.id %>"
               class="text-xs text-forge-accent hover:opacity-70 flex items-center gap-1">
              <i data-lucide="eye" class="w-3 h-3"></i> Ver
            </a>

            <% if (s.status === 'draft' || s.status === 'failed') { %>
              <form method="POST" action="/historia/<%= s.id %>/generar" class="inline">
                <button type="submit"
                        class="text-xs text-forge-accent hover:opacity-70 flex items-center gap-1 bg-transparent border-none cursor-pointer p-0">
                  <i data-lucide="zap" class="w-3 h-3"></i>
                  <%= s.status === 'failed' ? 'Reintentar' : 'Generar' %>
                </button>
              </form>
            <% } else if (s.status === 'processing') { %>
              <a href="/generar/stream/<%= s.id %>"
                 class="text-xs text-blue-400 hover:opacity-70 flex items-center gap-1">
                <i data-lucide="loader" class="w-3 h-3 animate-spin"></i> Ver progreso
              </a>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
