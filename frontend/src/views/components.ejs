<div class="max-w-3xl space-y-12">
  <div>
    <h2 class="font-serif text-2xl text-forge-accent mb-1">Catálogo de Componentes</h2>
    <p class="text-forge-muted text-xs uppercase tracking-widest">
      Tema activo: <span class="text-forge-accent"><%= activeTheme %></span>
    </p>
  </div>

  <%/* ── Botones ──────────────────────────────────────── */%>
  <section>
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-4 border-b border-forge-border pb-2">Botones</h3>
    <div class="flex flex-wrap gap-3">
      <button class="px-5 py-2 bg-forge-accent text-forge-text text-sm tracking-widest uppercase
                     hover:opacity-80 transition-opacity">
        Primario
      </button>
      <button class="px-5 py-2 border border-forge-accent text-forge-accent text-sm tracking-widest uppercase
                     hover:bg-forge-accent hover:text-forge-text transition-colors">
        Secundario
      </button>
      <button class="px-5 py-2 bg-forge-surface border border-forge-border text-forge-muted text-sm
                     tracking-widest uppercase hover:text-forge-text transition-colors">
        Neutro
      </button>
      <button class="inline-flex items-center gap-2 px-5 py-2 bg-forge-accent text-forge-text text-sm
                     tracking-widest uppercase hover:opacity-80 transition-opacity">
        <i data-lucide="pen-line" class="w-4 h-4"></i>
        Con icono
      </button>
    </div>
  </section>

  <%/* ── Inputs ──────────────────────────────────────── */%>
  <section>
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-4 border-b border-forge-border pb-2">Inputs</h3>
    <div class="space-y-4 max-w-md">
      <div>
        <label class="block text-xs uppercase tracking-widest text-forge-muted mb-1">Campo de texto</label>
        <input type="text" placeholder="Escribe aquí..."
               class="w-full bg-forge-surface border border-forge-border text-forge-text text-sm px-4 py-2
                      focus:outline-none focus:border-forge-accent transition-colors placeholder:text-forge-muted" />
      </div>
      <div>
        <label class="block text-xs uppercase tracking-widest text-forge-muted mb-1">Área de texto</label>
        <textarea rows="3" placeholder="Descripción larga..."
                  class="w-full bg-forge-surface border border-forge-border text-forge-text text-sm px-4 py-2
                         focus:outline-none focus:border-forge-accent transition-colors placeholder:text-forge-muted resize-none"></textarea>
      </div>
    </div>
  </section>

  <%/* ── Badges ──────────────────────────────────────── */%>
  <section>
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-4 border-b border-forge-border pb-2">Badges</h3>
    <div class="flex flex-wrap gap-3">
      <span class="px-2 py-0.5 bg-green-950 text-green-400 text-xs font-bold rounded">ONLINE</span>
      <span class="px-2 py-0.5 bg-red-950 text-red-400 text-xs font-bold rounded">OFFLINE</span>
      <span class="px-2 py-0.5 bg-forge-surface border border-forge-border text-forge-muted text-xs rounded">PENDIENTE</span>
      <span class="px-2 py-0.5 text-xs font-bold rounded"
            style="background-color: color-mix(in srgb, var(--forge-accent) 20%, transparent);
                   color: var(--forge-accent)">ACTIVO</span>
    </div>
  </section>

  <%/* ── Cards ──────────────────────────────────────── */%>
  <section>
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-4 border-b border-forge-border pb-2">Cards</h3>
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-forge-surface border border-forge-border p-5 hover:border-forge-accent transition-colors">
        <div class="flex items-center gap-2 mb-2">
          <i data-lucide="book-open" class="w-4 h-4 text-forge-accent"></i>
          <span class="text-sm text-forge-text">Historia de ejemplo</span>
        </div>
        <p class="text-xs text-forge-muted">Completada — 5 beats</p>
      </div>
      <div class="bg-forge-surface border border-forge-border p-5 hover:border-forge-accent transition-colors">
        <div class="flex items-center gap-2 mb-2">
          <i data-lucide="loader" class="w-4 h-4 text-forge-muted"></i>
          <span class="text-sm text-forge-muted">Generando...</span>
        </div>
        <p class="text-xs text-forge-muted">Beat 3 de 5</p>
      </div>
    </div>
  </section>

  <%/* ── Colores del tema activo ─────────────────────── */%>
  <section>
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-4 border-b border-forge-border pb-2">Paleta del tema</h3>
    <div class="flex gap-3 flex-wrap">
      <% [['bg','Fondo'],['surface','Superficie'],['border','Borde'],['accent','Acento'],['muted','Atenuado'],['text','Texto']].forEach(([key, label]) => { %>
        <div class="text-center">
          <div class="w-12 h-12 rounded border border-forge-border mb-1" style="background-color: var(--forge-<%= key %>)"></div>
          <span class="text-xs text-forge-muted"><%= label %></span>
        </div>
      <% }) %>
    </div>
  </section>
</div>
