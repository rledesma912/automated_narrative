<%/*
  Spec-580 D7: bienvenida corta, en el tono del sitio, que entra entera en la
  pantalla (sin scroll a 1366×768 con el menú abierto).
*/%>
<%
  const pasos = [
    { icon: 'lightbulb',     titulo: 'Tu idea',    texto: 'Contá de qué trata en dos o tres frases, como se lo contarías a alguien.' },
    { icon: 'message-circle', titulo: 'Preguntas', texto: 'La IA te pregunta lo que le falta para que dé miedo de verdad.' },
    { icon: 'list-ordered',  titulo: 'Los actos',  texto: 'Mirás la historia acto por acto y cambiás lo que quieras.' },
    { icon: 'feather',       titulo: 'El relato',  texto: 'La IA lo escribe acto por acto. Lo podés leer, copiar o descargar.' },
  ];
%>
<div class="max-w-4xl mx-auto py-6" data-inicio>
  <header class="mb-8">
    <h1 class="font-serif text-3xl text-forge-accent mb-2">Contemos una historia de miedo</h1>
    <p class="text-forge-muted max-w-2xl">Vos traés la idea y la IA te ayuda a armarla. No hace falta saber de escritura: te va guiando paso a paso.</p>
  </header>

  <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <% pasos.forEach((p, i) => { %>
      <li class="bg-forge-surface border border-forge-border p-5">
        <p class="flex items-center gap-2 mb-2">
          <span class="w-7 h-7 rounded-full bg-forge-accent text-forge-on-accent text-sm flex items-center justify-center shrink-0"><%= i + 1 %></span>
          <span class="font-serif text-lg"><%= p.titulo %></span>
        </p>
        <p class="text-sm text-forge-muted"><%= p.texto %></p>
      </li>
    <% }) %>
  </ol>

  <p class="nota-forge nota-forge--info mb-8 max-w-2xl">
    <i data-lucide="lightbulb" class="nota-forge__icono"></i>
    <span>Un consejo: contá cosas que pasan («suena el timbre de una habitación cerrada») más que lo que se siente («tiene mucho miedo»). El miedo sale solo.</span>
  </p>

  <div class="flex flex-wrap items-center gap-4">
    <a href="/nuevo" class="btn-forge-sm">
      <i data-lucide="pen-line" class="w-4 h-4"></i> Contar una historia nueva
    </a>
    <a href="/galeria" class="btn-forge-outline-sm">
      <i data-lucide="library" class="w-4 h-4"></i> Ver mis historias
    </a>
  </div>
</div>
