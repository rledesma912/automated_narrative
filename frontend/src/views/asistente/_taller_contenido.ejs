<%/*
  Spec-630 S2: el contenido de «Preguntas» (cómo viene, lo que falta, lo que ya
  está). Lo incluye taller.ejs y lo devuelve solo GET /asistente/:id/fragmento/taller,
  para actualizar sin recargar. Entrada: state, estimateLabels.
*/%>
<%
  const w = state.workshop;
  /* Spec-550 H9: el estado de cada criterio es un chip (no se toca). */
  const SEMAFORO = {
    cumple:      { label: 'Listo',       chip: 'chip-forge chip-forge--cumple' },
    parcial:     { label: 'A medias',    chip: 'chip-forge chip-forge--parcial' },
    falta:       { label: 'Falta',       chip: 'chip-forge chip-forge--falta' },
    intencional: { label: 'A propósito', chip: 'chip-forge' },
    no_aplica:   { label: 'No va en tu historia', chip: 'chip-forge chip-forge--no-va' },  /* Spec-670 D8 */
  };
  /* Spec-690: el final que la IA sacó de «¿De qué trata?». */
  const DE_TU_IDEA = { label: 'De tu idea', chip: 'chip-forge chip-forge--info' };
  const chipDe = (i) => (i.de_la_idea ? DE_TU_IDEA : SEMAFORO[i.status]);
  const abiertas = w.items.filter(i => (i.status === 'falta' || i.status === 'parcial') && i.question);
  const noVan = w.items.filter(i => i.status === 'no_aplica');
  const resueltas = w.items.filter(i => !abiertas.includes(i) && !noVan.includes(i));
  /* Spec-670: las preguntas por grupo (de toda historia, de la forma, del giro). */
  const m = w.molde || {};
  const GRUPOS = [
    ['base', 'De toda historia'],
    ['forma', m.form_name ? `De «${m.form_name}»` : 'De tu clase de historia'],
    ['giro', m.ingredient_name ? `Del giro · ${m.ingredient_name}` : 'Del giro'],
  ].map(([id, titulo]) => ({ titulo, items: w.items.filter(i => (i.grupo || 'base') === id) })).filter(g => g.items.length);
  const est = locals.estimateLabels || {};
  const analizado = w.items.length > 0;
%>
  <% if (!analizado) { %>
    <section class="bg-forge-surface border border-forge-border p-10 text-center mb-8">
      <i data-lucide="sparkles" class="w-10 h-10 text-forge-accent mx-auto mb-4"></i>
      <p class="font-serif text-xl mb-2">Todavía no hay preguntas</p>
      <p class="text-forge-muted mb-6">La IA la lee y te pregunta lo que le falta. Tarda <%= est.consult || 'unos segundos' %>.</p>
      <button type="button" class="btn-forge-sm" data-analizar="consult" data-titulo="Leyendo tu historia…"
              data-detalle="La IA lee tu idea para ver qué le falta y qué preguntarte.">
        <i data-lucide="sparkles" class="w-4 h-4"></i> Que la IA me pregunte
      </button>
    </section>
  <% } else { %>
    <% if (state.idea_cambio && state.idea_cambio.preguntas) { %>
      <%/* Spec-700 A2: la idea cambió después de estas preguntas; «Dejarlo así» la sella sin IA (D16). */%>
      <div class="nota-forge nota-forge--warning mb-8" data-idea-cambio="preguntas">
        <i data-lucide="alert-triangle" class="nota-forge__icono"></i>
        <p class="flex-1">Cambiaste tu idea después de estas preguntas. La IA la puede volver a leer y preguntarte lo que haga falta.</p>
        <button type="button" class="nota-forge__accion" data-analizar="consult" data-titulo="Leyendo tu idea nueva…"
                data-detalle="La IA vuelve a leer tu idea y pregunta lo que haga falta.">Que la IA la vuelva a leer</button>
        <button type="button" class="nota-forge__accion" data-idea-revisada="preguntas">Dejarlo así</button>
      </div>
    <% } %>
    <section class="bg-forge-surface border border-forge-border p-6 mb-8">
      <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-2">Cómo viene tu historia</h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>Unas preguntas son de toda historia; otras, de la clase de historia que elegiste en «Tu idea», y una del giro si elegiste uno. Son 10 como mucho y ninguna es obligatoria.</p>
      <div class="space-y-3 mb-5">
        <% GRUPOS.forEach(g => { %>
          <div data-grupo>
            <% if (GRUPOS.length > 1) { %><p class="text-[10px] uppercase tracking-widest text-forge-muted mb-1"><%= g.titulo %></p><% } %>
            <ul class="flex flex-wrap gap-2">
              <% g.items.forEach(i => { const s = chipDe(i); %>
                <li class="<%= s.chip %> chip-forge--md" title="<%= s.label %>: <%= i.por_que %>"><%= i.nombre %></li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
      </div>
      <% if (w.finish.kind === 'mal_elegida') { %>
        <div class="nota-forge nota-forge--warning" data-fin="mal_elegida"><i data-lucide="alert-triangle" class="nota-forge__icono"></i>
          <span><%= w.finish.text %> <a class="nota-forge__accion" href="/asistente/<%= state.story_id %>/direccion#forma">Cambiar la clase de historia</a></span></div>
      <% } else { %>
        <p class="nota-forge nota-forge--info" data-fin="<%= w.finish.kind %>"><i data-lucide="info" class="nota-forge__icono"></i><span><%= w.finish.text %></span></p>
      <% } %>
      <% if (w.hidden_answers) { %>
        <p class="nota-forge nota-forge--info mt-3" data-guardadas><i data-lucide="archive" class="nota-forge__icono"></i>
          <span>Tenés <%= w.hidden_answers === 1 ? '1 respuesta' : `${w.hidden_answers} respuestas` %> de otra clase de historia que esta no usa. Quedan guardadas: vuelven si volvés a esa clase.</span></p>
      <% } %>
    </section>

    <% if (abiertas.length) { %>
      <h3 class="font-serif text-xl mb-4">Te falta contarme</h3>
      <div class="space-y-6 mb-12">
        <% abiertas.forEach(p => { const s = chipDe(p); %>
          <article class="bg-forge-surface border border-forge-border p-6" data-pregunta="<%= p.criterion %>">
            <div class="flex items-center justify-between gap-4 mb-3">
              <span class="text-xs uppercase tracking-widest text-forge-muted"><%= p.nombre %></span>
              <span class="<%= s.chip %>"><%= s.label %></span>
            </div>
            <p class="font-serif text-xl mb-2"><%= p.question %></p>
            <p class="pista-forge mb-5"><i data-lucide="lightbulb"></i><%= p.por_que %></p>
            <fieldset class="space-y-2 mb-4">
              <legend class="sr-only">Opciones</legend>
              <% p.options.forEach(o => { %>
                <label class="opcion-forge">
                  <input type="radio" name="op-<%= p.criterion %>" value="<%= o %>" class="peer sr-only">
                  <span class="opcion-forge__caja"><%= o %></span>
                </label>
              <% }) %>
              <label class="opcion-forge opcion-forge--mia">
                <input type="radio" name="op-<%= p.criterion %>" value="" data-mia class="peer sr-only">
                <span class="opcion-forge__caja">Escribir la mía…</span>
              </label>
              <textarea data-texto-mia rows="2" maxlength="600" placeholder="Tu respuesta"
                        class="hidden w-full [field-sizing:content] bg-forge-bg border border-forge-border px-3 py-2"></textarea>
            </fieldset>
            <p class="hidden text-sm text-forge-error mb-3" data-error role="alert"></p>
            <div class="flex flex-wrap items-center gap-3">
              <button type="button" class="btn-forge-sm" data-taller="answer">Guardar respuesta</button>
              <button type="button" class="btn-forge-outline-sm" data-taller="decide" title="La IA elige por vos la opción que le parece más fuerte.">
                <i data-lucide="sparkles" class="w-4 h-4"></i> Decidí vos
              </button>
              <button type="button" class="btn-forge-outline-sm" data-taller="intentional" title="Queda como está y no se vuelve a preguntar">
                <i data-lucide="lock" class="w-4 h-4"></i> Es así a propósito
              </button>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>

    <% if (noVan.length) { %>
      <%/* Spec-670 D8: la IA vio que la idea las contradice; no se preguntan (D12: «Preguntármelo igual» las reabre). */%>
      <h3 class="font-serif text-xl mb-2">No van en tu historia</h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>La IA vio que tu idea las contradice y no te las pregunta. Si no estás de acuerdo, tocá «Preguntármelo igual».</p>
      <ul class="space-y-3 mb-12">
        <% noVan.forEach(p => { %>
          <li class="bg-forge-surface border border-forge-border px-5 py-4" data-pregunta="<%= p.criterion %>" data-no-va>
            <div class="flex flex-wrap items-start gap-4">
              <div class="flex-1 min-w-0">
                <p class="flex flex-wrap items-center gap-2 mb-1"><span class="text-xs uppercase tracking-widest text-forge-muted"><%= p.nombre %></span><span class="chip-forge">No va en tu historia</span></p>
                <p><%= p.question %></p>
              </div>
              <button type="button" class="btn-forge-outline-sm shrink-0" data-taller="reopen">Preguntármelo igual</button>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <% if (resueltas.length) { %>
      <h3 class="font-serif text-xl mb-4">Ya lo tenés</h3>
      <ul class="space-y-3 mb-12">
        <% resueltas.forEach(p => { const s = chipDe(p); %>
          <li class="bg-forge-surface border border-forge-border px-5 py-4" data-pregunta="<%= p.criterion %>">
            <div class="flex items-start gap-4">
              <div class="flex-1">
                <p class="flex flex-wrap items-center gap-2 mb-1"><span class="text-xs uppercase tracking-widest text-forge-muted"><%= p.nombre %></span><span class="<%= s.chip %>"><%= s.label %></span></p>
                <p><%= p.status === 'no_aplica' ? `La IA no te lo pregunta: ${p.question}` : p.answer || (p.status === 'cumple' ? 'Ya está en tu historia.' : p.status === 'intencional' ? 'Lo dejaste así a propósito: la IA no lo va a preguntar.' : 'Sin pregunta por ahora.') %></p>
                <p class="pista-forge mt-2"><i data-lucide="lightbulb"></i><%= p.de_la_idea ? 'Lo sacamos de tu idea. Si no es así, tocá «Cambiar» y dejalo como querés.' : p.por_que %></p>
                <% if (p.no_coincide) { %>
                  <%/* Spec-700 A3: la IA marca, no pisa. «Cambiar» la reescribe; «Está bien así» la deja. */%>
                  <div class="nota-forge nota-forge--warning mt-3" data-no-coincide>
                    <i data-lucide="alert-triangle" class="nota-forge__icono"></i>
                    <p class="flex-1">Esto ya no va con tu idea nueva: <%= p.no_coincide %></p>
                    <button type="button" class="nota-forge__accion" data-taller="keep">Está bien así</button>
                  </div>
                <% } %>
              </div>
              <button type="button" class="btn-forge-outline-sm shrink-0" data-cambiar>Cambiar</button>
            </div>
            <div class="hidden mt-4 pl-6" data-cambio>
              <textarea data-texto-mia rows="2" maxlength="2000" class="w-full [field-sizing:content] bg-forge-bg border border-forge-border px-3 py-2 mb-3"><%= p.answer %></textarea>
              <p class="hidden text-sm text-forge-error mb-3" data-error role="alert"></p>
              <div class="flex flex-wrap gap-3">
                <button type="button" class="btn-forge-sm" data-taller="answer">Guardar</button>
                <button type="button" class="btn-forge-outline-sm" data-taller="reopen" title="La IA lo vuelve a mirar la próxima vez que te pregunte">Que la IA lo vuelva a preguntar</button>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  <% } %>
