<%/*
  Spec-530: pasos del asistente. Entrada: state (null si la historia todavía no
  existe), pasoActual.
*/%>
<%
  const sid = state ? state.story_id : null;
  const pasos = [
    { id: 'direccion', label: 'Tu idea', href: sid ? `/asistente/${sid}/direccion` : '/nuevo' },
    { id: 'taller',    label: 'Preguntas', href: sid ? `/asistente/${sid}/taller` : null },
    { id: 'escaleta',  label: 'Los actos', href: sid ? `/asistente/${sid}/escaleta` : null },
    { id: 'relato',    label: 'El relato', href: sid && state.status === 'completed' ? `/historia/${sid}/relatos` : null },
  ];
  const idx = pasos.findIndex(p => p.id === pasoActual);
%>
<%/* Spec-550 H11: los pasos viven en la barra fija. Estilo de navegación: ni
     chip ni botón. En pantallas angostas quedan solo los números. */%>
<nav aria-label="Pasos del asistente">
<ol class="pasos-forge">
  <% pasos.forEach((p, i) => { %>
    <li class="flex items-center gap-1">
      <% const estado = i === idx ? 'pasos-forge__paso--actual' : p.href ? 'pasos-forge__paso--link' : 'pasos-forge__paso--no'; %>
      <% if (p.href && i !== idx) { %>
        <a href="<%= p.href %>" class="pasos-forge__paso <%= estado %>" title="<%= p.label %>">
      <% } else { %>
        <span class="pasos-forge__paso <%= estado %>" title="<%= p.label %>" <%- i === idx ? 'aria-current="step"' : '' %>>
      <% } %>
        <span class="pasos-forge__numero"><%= i + 1 %></span>
        <span class="hidden md:inline"><%= p.label %></span>
      <%- p.href && i !== idx ? '</a>' : '</span>' %>
      <% if (i < pasos.length - 1) { %><span class="pasos-forge__linea" aria-hidden="true"></span><% } %>
    </li>
  <% }) %>
</ol>
</nav>
