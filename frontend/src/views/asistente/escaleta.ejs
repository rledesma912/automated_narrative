<%/*
  Spec-530 S4 — Escaleta: una tarjeta por acto, con guardado automático. Los
  avisos de la revisión van en la tarjeta del acto. Personajes y escenarios se
  suman acá, cuando hacen falta (decisión 14).
  Entrada: state, estimateLabels.
*/%>
<%
  const acts = state.outline.acts;
  const est = locals.estimateLabels || {};
  /* Spec-650: cuántos actos tiene, en palabras («tres» o «cinco»). */
  const cuantosActos = ({ 3: 'tres', 5: 'cinco' })[state.structure_acts.length] || String(state.structure_acts.length);
%>
<div data-asistente="escaleta" data-story-id="<%= state.story_id %>">
  <%/* Barra fija arriba de todo: guardado automático + acciones del paso. */%>
  <div class="asistente-barra">
    <%- include('_cabecera') %>
    <% if (acts.length) { %>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn-forge-outline-sm" data-analizar="verify_outline" data-titulo="Revisando los actos…"
                data-detalle="La IA busca respuestas tuyas que quedaron afuera, cosas repetidas o fuera de lugar y secretos que nunca se descubren.">
          <i data-lucide="search-check" class="w-4 h-4"></i> Que la IA lo revise<% if (est.verify_outline) { %> <span class="normal-case tracking-normal text-forge-muted">· <%= est.verify_outline %></span><% } %>
        </button>
        <%/* Spec-660 B1: pregunta acá (escribir-relato.js) y va a la sala ya escribiendo. */%>
        <button type="button" class="btn-forge-sm" data-escribir-relato data-generation-trigger data-story-id="<%= state.story_id %>"
                data-estimado="<%= est.full_generation || '' %>"<% if (state.status === 'completed') { %> data-version-nueva<% } %>>
          <i data-lucide="feather" class="w-4 h-4"></i> Escribir el relato<% if (est.full_generation) { %> <span class="normal-case tracking-normal">· <%= est.full_generation %></span><% } %>
        </button>
      </div>
    <% } %>
  </div>

  <%/* Spec-630 B3: aprovecha el ancho (hasta 96rem); el encabezado sigue angosto para leerse bien. */%>
  <div class="max-w-screen-2xl">

  <header class="mb-8 max-w-3xl">
    <h2 class="font-serif text-3xl text-forge-accent mb-2">Los actos</h2>
    <p class="text-forge-muted">Los <%= cuantosActos %> actos de tu historia antes de escribirla. Cambiá lo que quieras: el relato sale de acá.</p>
  </header>

  <%- include('_escaleta_contenido') %>

  </div>
</div>

<%- include('_guardado') %>
<%- include('_analizando') %>
<script type="application/json" id="asistente-datos"><%- JSON.stringify({ state }).replace(/</g, '\\u003c') %></script>
<script src="/js/asistente.js?v=<%= locals.assetVersion || '' %>"></script>
