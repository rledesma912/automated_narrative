<%/*
  Spec-530 S4 — Dirección: pocas decisiones, una por tarjeta, cada una con su
  «por qué importa». Guardado automático; la IA solo con «Analizar mi historia».
  Entrada: state (null = historia nueva), options, genres, estimateLabels.
*/%>
<%
  const d = state ? state.direction : {
    title: '', genero: '', subgenero: '', premise: '', effect: '', effect_other: '', ending: '',
    ending_intentional: false, telling: '', protagonist_name: '', protagonist_role: '', narrator: '', threat: null,
    form: '', ingredient: '', form_other: '', form_suggested: '', form_reason: '', habla: '',
  };
  const t = d.threat || { name: '', nature: '', description: '', manifestations: '', limits: '', reveal_level: 'insinuada' };
  const genre = genres.find(g => g.id === d.genero);
  const others = state ? state.characters.slice(1).filter(c => c.kind === 'persona') : [];
  const est = (locals.estimateLabels && estimateLabels.consult) || '';
  /* Spec-650: el largo no viaja con el guardado automático (D9): se manda al crear y se
     cambia aparte, con confirmación si ya hay actos (public/js/asistente.js). */
  const largo = state ? state.structure : 'largo';
  const largos = options.structures || [];
  /* Spec-670: la clase de historia y el giro. Sin forma elegida, la de siempre (la primera). */
  const formas = options.forms || [];
  const giros = options.ingredients || [];
  /* Spec-680 C1: cómo habla quien narra. Sin elegir (historias viejas), la de siempre. */
  const hablas = options.hablas || [];
  const habla = d.habla || (hablas[0] && hablas[0].id);
  const sugerida = formas.find(f => f.id === d.form_suggested);
  const uso = (state && state.ingredient_usage) || {};
  const estForma = (locals.estimateLabels && estimateLabels.suggest_form) || '';
  const REVEAL = [
    ['nunca', 'Nunca se muestra'], ['insinuada', 'Se insinúa'],
    ['progresiva', 'Se va mostrando'], ['explicita', 'Se muestra entera'],
  ];
%>
<div data-asistente="direccion" data-story-id="<%= state ? state.story_id : '' %>" data-largo="<%= largo %>">
  <%/* Barra fija arriba de todo: guardado automático + acciones del paso. */%>
  <div class="asistente-barra">
    <%- include('_cabecera') %>
    <button type="button" class="btn-forge-sm"
            data-analizar="consult"
            data-titulo="Leyendo tu historia…"
            data-detalle="La IA lee tu idea para ver qué le falta y qué preguntarte."
            data-destino="taller"
            <%= state ? '' : 'disabled' %>>
      <i data-lucide="sparkles" class="w-4 h-4"></i> Que la IA me pregunte<% if (est) { %> <span class="normal-case tracking-normal">· <%= est %></span><% } %>
    </button>
  </div>

  <div class="max-w-3xl">

  <header class="mb-10">
    <h2 class="font-serif text-3xl text-forge-accent mb-2">¿Qué historia querés contar?</h2>
    <p class="text-forge-muted">Con esto alcanza para empezar. Después la IA te hace algunas preguntas para completar lo que falte.</p>
  </header>

  <form class="space-y-6" data-autosave="direction" onsubmit="return false" novalidate>

    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-4">El título y el tipo de horror</h3>
      <label class="block text-sm text-forge-muted mb-1" for="a-title">Título</label>
      <input id="a-title" name="title" type="text" required maxlength="120" value="<%= d.title %>"
             placeholder="Por ejemplo: la pena del colectivo"
             class="w-full bg-forge-bg border border-forge-border px-3 py-2 mb-4 focus:outline-none focus:border-forge-accent">
      <% if (!state) { %><p class="pista-forge -mt-2 mb-4" data-pista-titulo><i data-lucide="info"></i>Se guarda solo cuando escribas el título.</p><% } %>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="a-genero">Tipo de horror</label>
          <select id="a-genero" name="genero" class="w-full bg-forge-bg border border-forge-border px-3 py-2">
            <option value="">Elegí uno…</option>
            <% genres.forEach(g => { %><option value="<%= g.id %>" <%= g.id === d.genero ? 'selected' : '' %>><%= g.label %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="a-subgenero">Estilo</label>
          <select id="a-subgenero" name="subgenero" class="w-full bg-forge-bg border border-forge-border px-3 py-2" <%= genre ? '' : 'disabled' %>>
            <option value="">Elegí uno…</option>
            <% (genre ? genre.subgenres : []).forEach(s => { %><option value="<%= s.id %>" <%= s.id === d.subgenero ? 'selected' : '' %>><%= s.label %></option><% }) %>
          </select>
        </div>
      </div>
    </section>

    <% if (largos.length) { %>
    <section class="bg-forge-surface border border-forge-border p-6" data-largo-opciones>
      <h3 class="font-serif text-xl mb-1">¿Qué tan largo?</h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>
        Es lo que dura leído en voz alta. El corto cuenta lo mismo en menos actos.</p>
      <div class="grid sm:grid-cols-2 gap-3">
        <% largos.forEach(l => { const [nombre, ...resto] = l.label.split(' · '); %>
          <label class="opcion-forge h-full">
            <input type="radio" name="structure" value="<%= l.id %>" class="peer sr-only" <%= l.id === largo ? 'checked' : '' %>>
            <span class="opcion-forge__caja h-full">
              <span>
                <span class="block font-semibold"><%= nombre %></span>
                <span class="block text-sm text-forge-muted"><%= resto.join(' · ') %></span>
              </span>
            </span>
          </label>
        <% }) %>
      </div>
    </section>
    <% } %>

    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-1"><label for="a-premise">¿De qué trata?</label></h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>
        Contalo como se lo contarías a alguien, de punta a punta: qué pasa y cómo termina, si ya lo sabés. No hace falta ordenarlo en actos: eso lo hacemos después.</p>
      <textarea id="a-premise" name="premise" rows="4" maxlength="6000"
                class="w-full [field-sizing:content] min-h-[6rem] bg-forge-bg border border-forge-border px-3 py-2 leading-relaxed focus:outline-none focus:border-forge-accent"><%= d.premise %></textarea>
    </section>

    <% if (formas.length) { %>
    <%/* Spec-670: «¿Qué clase de historia es?» — la IA la sugiere (job suggest_form) y la persona decide. */%>
    <section class="bg-forge-surface border border-forge-border p-6" id="forma" data-formas>
      <h3 class="font-serif text-xl mb-1">¿Qué clase de historia es?</h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>
        De esto depende qué te pregunta la IA y qué pasa en cada acto: no te va a preguntar cosas que tu historia no tiene.
        Si no sabés cuál es, que la IA te sugiera una leyendo tu idea; si no es ninguna, elegí «Otra» y contala con tus palabras.
        La podés cambiar cuando quieras: lo que ya respondiste no se pierde.</p>
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <button type="button" class="btn-forge-outline-sm" data-analizar="suggest_form" data-titulo="Leyendo tu idea…"
                data-detalle="La IA busca qué clase de historia es." <%= state ? '' : 'disabled' %>>
          <i data-lucide="sparkles" class="w-4 h-4"></i> Que la IA lo sugiera<% if (estForma) { %> <span class="normal-case tracking-normal text-forge-muted">· <%= estForma %></span><% } %>
        </button>
      </div>
      <% if (sugerida && d.form_reason) { %>
        <p class="nota-forge nota-forge--info mb-4" data-sugerencia><i data-lucide="sparkles" class="nota-forge__icono"></i>
          <span>La IA sugiere <strong>«<%= sugerida.nombre %>»</strong>: <%= d.form_reason %><% if (d.form && d.form !== sugerida.id) { %> Si te convence, elegila abajo.<% } %></span></p>
      <% } %>
      <div class="grid sm:grid-cols-2 gap-3">
        <% formas.forEach(f => { %>
          <label class="opcion-forge h-full">
            <input type="radio" name="form" value="<%= f.id %>" class="peer sr-only" <%= f.id === d.form ? 'checked' : '' %>>
            <span class="opcion-forge__caja h-full">
              <span>
                <% if (sugerida && f.id === sugerida.id) { %><span class="block text-[10px] uppercase tracking-widest font-bold" data-sugerida>Sugerida por la IA</span><% } %>
                <span class="block font-semibold"><%= f.nombre %></span>
                <span class="block text-sm text-forge-muted"><%= f.ayuda %></span>
              </span>
            </span>
          </label>
        <% }) %>
      </div>
      <div class="<%= (formas.find(f => f.id === d.form) || {}).otra ? '' : 'hidden' %> mt-3" data-solo-si-forma="otra">
        <label class="pista-forge mb-1 block" for="a-form-other">Contá en una o dos frases cómo es tu historia: qué pasa al principio, qué cambia y cómo queda.</label>
        <textarea id="a-form-other" name="form_other" rows="2" maxlength="600"
                  class="w-full [field-sizing:content] bg-forge-bg border border-forge-border px-3 py-2 focus:outline-none focus:border-forge-accent"><%= d.form_other %></textarea>
      </div>
      <% if (!d.form) { %><p class="pista-forge mt-3" data-sin-forma><i data-lucide="info"></i>Si no elegís ninguna, te pregunta como en «<%= formas[0].nombre %>».</p><% } %>
    </section>

    <%/* Spec-670: el giro (opcional). «Sorprendeme» sortea entre los menos usados (asistente.js). */%>
    <section class="bg-forge-surface border border-forge-border p-6" data-giros data-uso='<%- JSON.stringify(uso).replace(/'/g, "&#39;") %>'>
      <h3 class="font-serif text-xl mb-1">¿Le sumamos un giro?</h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>
        Es opcional. Un giro es un detalle que le da algo propio a tu historia y suma una sola pregunta.
        Elegí uno, dejá que lo sorteemos («Sorprendeme» elige entre los que menos usaste) o seguí sin giro.</p>
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <button type="button" class="btn-forge-outline-sm" data-sorprendeme><i data-lucide="shuffle" class="w-4 h-4"></i> Sorprendeme</button>
      </div>
      <p class="text-sm mb-3 hidden" data-giro-salio aria-live="polite"></p>
      <div class="grid sm:grid-cols-2 gap-3">
        <label class="opcion-forge h-full">
          <input type="radio" name="ingredient" value="" class="peer sr-only" <%= d.ingredient ? '' : 'checked' %>>
          <span class="opcion-forge__caja h-full"><span><span class="block font-semibold">Sin giro</span><span class="block text-sm text-forge-muted">Como viene.</span></span></span>
        </label>
        <% giros.forEach(g => { const fuera = g.no_con.includes(d.form); %>
          <label class="opcion-forge h-full<%= fuera ? ' hidden' : '' %>" data-giro="<%= g.id %>" data-no-con="<%= g.no_con.join(',') %>">
            <input type="radio" name="ingredient" value="<%= g.id %>" class="peer sr-only" <%= g.id === d.ingredient ? 'checked' : '' %>>
            <span class="opcion-forge__caja h-full">
              <span>
                <span class="block font-semibold"><%= g.nombre %></span>
                <span class="block text-sm text-forge-muted"><%= g.ayuda %></span>
              </span>
            </span>
          </label>
        <% }) %>
      </div>
    </section>
    <% } %>

    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-1">¿Qué querés que sienta quien lo escuche?</h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>
        Todo lo que sigue apunta a esto: las preguntas y los actos.</p>
      <div class="grid sm:grid-cols-2 gap-3">
        <% options.effects.forEach(e => { %>
          <label class="opcion-forge h-full">
            <input type="radio" name="effect" value="<%= e.id %>" class="peer sr-only" <%= e.id === d.effect ? 'checked' : '' %>>
            <span class="opcion-forge__caja h-full">
              <span>
                <span class="block font-semibold"><%= e.label %></span>
                <span class="block text-sm text-forge-muted"><%= e.detail %></span>
              </span>
            </span>
          </label>
        <% }) %>
      </div>
      <input type="text" name="effect_other" maxlength="200" value="<%= d.effect_other %>" data-solo-si-efecto="otro"
             placeholder="Contá qué efecto buscás"
             class="<%= d.effect === 'otro' ? '' : 'hidden' %> mt-3 w-full bg-forge-bg border border-forge-border px-3 py-2">
    </section>

    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-4">¿A quién le pasa y quién lo cuenta?</h3>
      <div class="grid sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="a-prota">Protagonista</label>
          <input id="a-prota" name="protagonist_name" type="text" maxlength="60" value="<%= d.protagonist_name %>" placeholder="Nombre"
                 class="w-full bg-forge-bg border border-forge-border px-3 py-2">
        </div>
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="a-quehace">¿Qué hace?</label>
          <input id="a-quehace" name="protagonist_role" type="text" maxlength="160" value="<%= d.protagonist_role %>"
                 placeholder="Por ejemplo: chofer de micros, turno noche"
                 class="w-full bg-forge-bg border border-forge-border px-3 py-2">
        </div>
      </div>
      <label class="block text-sm text-forge-muted mb-1" for="a-narra">Quién lo cuenta</label>
      <select id="a-narra" name="narrator" class="w-full sm:w-1/2 bg-forge-bg border border-forge-border px-3 py-2">
        <option value="">El protagonista</option>
        <% others.forEach(c => { %><option value="<%= c.name %>" <%= c.name === d.narrator ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
      <p class="text-xs text-forge-muted mt-2">Los demás personajes los sumás en el acto donde aparecen.</p>
    </section>

    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-1">¿Cómo lo cuenta?</h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>
        Elegí cómo suena la voz. Cada opción tiene un ejemplo de cómo arrancaría.</p>
      <div class="space-y-3">
        <% options.tellings.forEach(c => { %>
          <label class="opcion-forge">
            <input type="radio" name="telling" value="<%= c.id %>" class="peer sr-only" <%= c.id === d.telling ? 'checked' : '' %>>
            <span class="opcion-forge__caja">
              <span class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
                <span class="font-semibold sm:w-56 shrink-0"><%= c.label %></span>
                <span class="prose-forge italic text-forge-muted"><%= c.detail %></span>
              </span>
            </span>
          </label>
        <% }) %>
      </div>
    </section>

    <% if (hablas.length) { %>
    <section class="bg-forge-surface border border-forge-border p-6" data-hablas>
      <h3 class="font-serif text-xl mb-1">¿Cómo habla quien lo cuenta?</h3>
      <p class="pista-forge mb-4"><i data-lucide="lightbulb"></i>
        Cambia las palabras del relato: «vos» o «tú», «la plata» o «el dinero». Las preguntas y los avisos de esta página no cambian.</p>
      <div class="grid sm:grid-cols-2 gap-3">
        <% hablas.forEach(h => { %>
          <label class="opcion-forge h-full">
            <input type="radio" name="habla" value="<%= h.id %>" class="peer sr-only" <%= h.id === habla ? 'checked' : '' %>>
            <span class="opcion-forge__caja h-full">
              <span>
                <span class="block font-semibold"><%= h.label %></span>
                <span class="block text-sm text-forge-muted"><%= h.detail %></span>
              </span>
            </span>
          </label>
        <% }) %>
      </div>
    </section>
    <% } %>

    <details class="bg-forge-surface border border-forge-border p-6 group" <%= d.threat ? 'open' : '' %>>
      <summary class="cursor-pointer list-none flex items-center justify-between">
        <span>
          <span class="font-serif text-xl">La amenaza</span>
          <span class="ml-2 text-xs uppercase tracking-widest text-forge-muted">opcional</span>
        </span>
        <i data-lucide="chevron-down" class="w-5 h-5 text-forge-muted transition-transform group-open:rotate-180"></i>
      </summary>
      <p class="text-sm text-forge-muted mt-3 mb-4">Si tu historia tiene un ser, un lugar o una fuerza que acecha, describilo: qué quiere, cómo se manifiesta y qué no puede hacer. Si preferís, dejalo para después.</p>
      <div class="grid sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="a-t-nature">Qué es</label>
          <select id="a-t-nature" name="threat_nature" class="w-full bg-forge-bg border border-forge-border px-3 py-2" <%= genre ? '' : 'disabled' %>>
            <option value="">Sin amenaza</option>
            <% (genre && genre.entity_natures ? genre.entity_natures : []).forEach(n => { %>
              <option value="<%= n.id %>" <%= n.id === t.nature ? 'selected' : '' %>><%= n.label %></option>
            <% }) %>
          </select>
          <% if (!genre) { %><p class="text-xs text-forge-muted mt-1">Elegí primero el tipo de horror.</p><% } %>
        </div>
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="a-t-name">Nombre <span class="text-xs">(si tiene)</span></label>
          <input id="a-t-name" name="threat_name" type="text" maxlength="60" value="<%= t.name %>" class="w-full bg-forge-bg border border-forge-border px-3 py-2">
        </div>
      </div>
      <label class="block text-sm text-forge-muted mb-1" for="a-t-desc">Qué quiere</label>
      <textarea id="a-t-desc" name="threat_description" rows="2" maxlength="400" class="w-full [field-sizing:content] bg-forge-bg border border-forge-border px-3 py-2 mb-3"><%= t.description %></textarea>
      <label class="block text-sm text-forge-muted mb-1" for="a-t-man">Cómo se percibe</label>
      <textarea id="a-t-man" name="threat_manifestations" rows="2" maxlength="300" class="w-full [field-sizing:content] bg-forge-bg border border-forge-border px-3 py-2 mb-3"><%= t.manifestations %></textarea>
      <label class="block text-sm text-forge-muted mb-1" for="a-t-lim">Qué no puede hacer</label>
      <textarea id="a-t-lim" name="threat_limits" rows="2" maxlength="300" class="w-full [field-sizing:content] bg-forge-bg border border-forge-border px-3 py-2 mb-3"><%= t.limits %></textarea>
      <label class="block text-sm text-forge-muted mb-1" for="a-t-reveal">Cuánto se muestra</label>
      <select id="a-t-reveal" name="threat_reveal_level" class="w-full sm:w-1/2 bg-forge-bg border border-forge-border px-3 py-2">
        <% REVEAL.forEach(([id, label]) => { %><option value="<%= id %>" <%= id === t.reveal_level ? 'selected' : '' %>><%= label %></option><% }) %>
      </select>
    </details>

  </form>
  </div>
</div>

<%- include('_guardado') %>
<%- include('_analizando') %>
<script type="application/json" id="asistente-datos"><%- JSON.stringify({ state, genres }).replace(/</g, '\\u003c') %></script>
<script src="/js/asistente.js?v=<%= locals.assetVersion || '' %>"></script>
