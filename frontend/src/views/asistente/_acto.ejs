<%/*
  Spec-630 S2: la tarjeta de un acto. Entrada: a (el acto), state.
*/%>
<%
  /* Spec-550 H10: cada aviso tiene clave y estado; los ignorados no cuentan. */
  const visibles = (a) => a.warnings.filter(w => !w.dismissed);
  const ignorados = (a) => a.warnings.filter(w => w.dismissed);
  const narrador = state.direction.narrator || state.direction.protagonist_name;
  const NOMBRES = { 1: 'Cómo empieza', 2: 'Se complica', 3: 'El peor momento', 4: 'Qué hace después', 5: 'Cómo termina' };
  const INTENSIDAD = { 1: 'baja', 2: 'media', 3: 'alta', 4: 'media-alta', 5: 'baja' };
  const TIPOS = { persona: 'Con nombre', sin_nombre: 'Sin nombre', grupo: 'Grupo' };
  const PERSONAJE_FUERA = /^«(.+?)» aparece en este acto pero no está entre los personajes/;
  const field = 'bg-forge-bg border border-forge-border px-3 py-2 focus:outline-none focus:border-forge-accent';
  /* Spec-630 B7: «×» chico al lado de cada lugar y personaje (fuera de la opción, para no elegirla sin querer). */
  const borrar = 'text-forge-muted hover:text-forge-error p-0.5';
%>
        <%/* data-acto: la tarjeta que se reemplaza al actualizar; tabindex: recibe el foco si el control tocado desaparece. */%>
        <li class="grid grid-cols-[3rem_1fr] gap-4 focus:outline-none" data-acto="<%= a.number %>" tabindex="-1">
          <div class="flex flex-col items-center">
            <span class="w-10 h-10 rounded-full bg-forge-accent text-forge-on-accent font-serif text-lg flex items-center justify-center"><%= a.number %></span>
            <span class="flex-1 w-px bg-forge-border mt-2"></span>
          </div>

          <form class="bg-forge-surface border border-forge-border" data-autosave="act" data-number="<%= a.number %>" onsubmit="return false" novalidate>
            <header class="flex flex-wrap items-baseline justify-between gap-2 px-6 pt-5 pb-3 border-b border-forge-border">
              <h3 class="font-serif text-2xl">Acto <%= a.number %> · <%= NOMBRES[a.number] %></h3>
              <span class="text-xs uppercase tracking-widest text-forge-muted">tensión <%= INTENSIDAD[a.number] %></span>
            </header>

            <% if (visibles(a).length) { %>
              <%/* Spec-550 H9: cada aviso es una nota; sus acciones, links. */%>
              <div class="mx-6 mt-4 space-y-2">
                <% visibles(a).forEach(w => { const fuera = w.text.match(PERSONAJE_FUERA); %>
                  <div class="nota-forge nota-forge--warning" data-aviso-clave="<%= w.key %>">
                    <i data-lucide="alert-triangle" class="nota-forge__icono"></i>
                    <p class="flex-1"><%= w.text %></p>
                    <% if (fuera) { %><button type="button" class="nota-forge__accion" data-sumar-personaje="<%= fuera[1] %>" data-aviso="<%= w.key %>">Sumarlo a los personajes</button><% } %>
                    <button type="button" class="nota-forge__accion" data-ignorar="<%= w.key %>">Ignorar</button>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <% if (ignorados(a).length) { %>
              <%/* Spec-550 H10: lo ignorado no vuelve al revisar; se puede volver a mostrar. */%>
              <details class="mx-6 mt-3 text-sm" data-ignorados>
                <summary class="nota-forge__accion inline-block cursor-pointer text-forge-muted"><%= ignorados(a).length %> <%= ignorados(a).length === 1 ? 'aviso ignorado' : 'avisos ignorados' %></summary>
                <ul class="mt-2 space-y-2">
                  <% ignorados(a).forEach(w => { %>
                    <li class="flex items-start gap-3 text-forge-muted">
                      <i data-lucide="eye-off" class="w-4 h-4 shrink-0 mt-0.5"></i>
                      <p class="flex-1"><%= w.text %></p>
                      <button type="button" class="nota-forge__accion" data-restaurar="<%= w.key %>">Volver a mostrar</button>
                    </li>
                  <% }) %>
                </ul>
              </details>
            <% } %>

            <div class="grid lg:grid-cols-[1fr_18rem] gap-6 p-6">
              <div>
                <% if (a.number > 1) { %>
                  <%/* Spec-560 A1: el puente entre actos. */%>
                  <label class="block text-xs uppercase tracking-widest text-forge-muted mb-1" for="bridge-<%= a.number %>">Cómo llega acá</label>
                  <p class="pista-forge text-xs mb-2"><i data-lucide="lightbulb"></i>Cuánto tiempo pasó desde el acto anterior y qué pasó en el medio. El acto arranca contándolo.</p>
                  <textarea id="bridge-<%= a.number %>" name="bridge" rows="1" maxlength="300" class="w-full [field-sizing:content] resize-none <%= field %> mb-5"><%= a.bridge %></textarea>
                <% } %>
                <label class="block text-xs uppercase tracking-widest text-forge-muted mb-1" for="goal-<%= a.number %>">Qué quiere <%= state.direction.protagonist_name || 'el protagonista' %></label>
                <textarea id="goal-<%= a.number %>" name="goal" rows="1" maxlength="300" class="w-full [field-sizing:content] resize-none <%= field %> mb-5"><%= a.goal %></textarea>

                <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Qué pasa</p>
                <ol class="space-y-2 mb-3" data-lista="events">
                  <% a.events.forEach(h => { %>
                    <li class="group flex items-start gap-2" data-item>
                      <button type="button" class="mt-2 text-forge-muted hover:text-forge-accent" data-subir title="Subir"><i data-lucide="arrow-up" class="w-4 h-4"></i></button>
                      <textarea name="events" rows="1" maxlength="400" class="flex-1 [field-sizing:content] resize-none <%= field %>"><%= h %></textarea>
                      <button type="button" class="mt-2 text-forge-muted hover:text-forge-error" data-quitar title="Quitar"><i data-lucide="x" class="w-4 h-4"></i></button>
                    </li>
                  <% }) %>
                </ol>
                <button type="button" class="btn-forge-outline-sm mb-5" data-agregar="events"><i data-lucide="plus" class="w-4 h-4"></i> Agregar hecho</button>

                <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Qué cambia</p>
                <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                  <textarea name="change_from" rows="1" maxlength="200" aria-label="Al empezar" class="flex-1 [field-sizing:content] resize-none <%= field %>"><%= a.change_from %></textarea>
                  <i data-lucide="arrow-right" class="w-4 h-4 text-forge-accent shrink-0 self-center"></i>
                  <textarea name="change_to" rows="1" maxlength="200" aria-label="Al terminar" class="flex-1 [field-sizing:content] resize-none <%= field %>"><%= a.change_to %></textarea>
                </div>
              </div>

              <aside class="space-y-5 text-sm">
                <fieldset>
                  <legend class="text-xs uppercase tracking-widest text-forge-muted mb-2">Dónde pasa</legend>
                  <div class="flex flex-wrap gap-2">
                    <% state.scenarios.forEach(e => { %>
                      <span class="inline-flex items-center gap-0.5" data-lugar="<%= e.name %>">
                        <label class="opcion-forge opcion-forge--compacta">
                          <input type="radio" name="scenario" value="<%= e.name %>" class="peer sr-only" <%= e.name === a.scenario ? 'checked' : '' %>>
                          <span class="opcion-forge__caja"><%= e.name %></span>
                        </label>
                        <button type="button" class="<%= borrar %>" data-borrar-lugar="<%= e.name %>" data-usos="<%= e.acts.join(',') %>"
                                title="Borrar «<%= e.name %>»" aria-label="Borrar el lugar «<%= e.name %>»"><i data-lucide="x" class="w-3 h-3"></i></button>
                      </span>
                    <% }) %>
                    <button type="button" class="btn-forge-outline-sm" data-escenario-nuevo><i data-lucide="plus" class="w-3 h-3"></i> Lugar</button>
                  </div>
                  <%/* Spec-630 B6: el lugar se suma a la historia (opción en todos los actos) y queda elegido acá; el campo queda abierto para sumar otro. */%>
                  <div class="hidden mt-2 flex gap-2" data-lugar-form>
                    <input type="text" data-lugar-nombre maxlength="120" placeholder="Nombre del lugar" aria-label="Nombre del lugar nuevo" class="flex-1 min-w-0 <%= field %>">
                    <button type="button" class="btn-forge-outline-sm shrink-0" data-lugar-agregar>Agregar</button>
                  </div>
                </fieldset>

                <div>
                  <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Reglas en este acto</p>
                  <ul class="space-y-2 mb-1" data-lista="rules">
                    <% a.rules.forEach(r => { %>
                      <li class="flex items-start gap-2" data-item>
                        <textarea name="rules" rows="1" maxlength="300" class="flex-1 [field-sizing:content] resize-none <%= field %>"><%= r %></textarea>
                        <button type="button" class="mt-2 text-forge-muted hover:text-forge-error" data-quitar title="Quitar"><i data-lucide="x" class="w-4 h-4"></i></button>
                      </li>
                    <% }) %>
                  </ul>
                  <button type="button" class="btn-forge-outline-sm" data-agregar="rules" title="Algo que vale solo en este acto: «solo aparece cuando está solo»"><i data-lucide="plus" class="w-3 h-3"></i> Regla</button>
                </div>

                <% if (a.seeds.length || a.payoffs.length) { %>
                  <div>
                    <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Detalles que vuelven</p>
                    <% a.seeds.forEach(s => { %><p class="flex items-center gap-2 mb-1"><i data-lucide="sprout" class="w-4 h-4 text-forge-success shrink-0"></i>Aparece acá: <%= s %></p><% }) %>
                    <% a.payoffs.forEach(c => { %><p class="flex items-center gap-2 mb-1"><i data-lucide="link" class="w-4 h-4 text-forge-info shrink-0"></i>Vuelve de antes: <%= c %></p><% }) %>
                  </div>
                <% } %>

                <div>
                  <%/* Spec-560 A4: lo que el acto sabe pero todavía no cuenta, y dónde se revela. */%>
                  <label class="block text-xs uppercase tracking-widest text-forge-muted mb-1" for="held-<%= a.number %>">Lo que todavía es secreto</label>
                  <p class="pista-forge text-xs mb-2"><i data-lucide="lightbulb"></i>En este acto no se cuenta; se descubre más adelante.</p>
                  <textarea id="held-<%= a.number %>" name="held_back" rows="1" maxlength="300" class="w-full [field-sizing:content] resize-none <%= field %>"><%= a.held_back %></textarea>
                  <% if (a.number < 5) { %>
                    <label class="flex items-center gap-2 mt-2 text-xs text-forge-muted" for="reveal-<%= a.number %>">Se descubre en
                      <select id="reveal-<%= a.number %>" name="reveal_act" class="bg-forge-bg border border-forge-border px-2 py-1">
                        <option value="0" <%= a.reveal_act ? '' : 'selected' %>>—</option>
                        <% for (let n = a.number + 1; n <= 5; n++) { %><option value="<%= n %>" <%= a.reveal_act === n ? 'selected' : '' %>>el Acto <%= n %></option><% } %>
                      </select>
                    </label>
                  <% } %>
                </div>

                <fieldset>
                  <legend class="text-xs uppercase tracking-widest text-forge-muted mb-1">Quiénes están</legend>
                  <p class="pista-forge text-xs mb-2">En este acto aparecen solo ellos.</p>
                  <div class="flex flex-wrap gap-2">
                    <% state.characters.forEach(c => { const narra = c.name === narrador; const on = narra || a.on_stage.includes(c.name); %>
                      <span class="inline-flex items-center gap-0.5" data-personaje="<%= c.name %>">
                        <label class="opcion-forge opcion-forge--compacta opcion-forge--check">
                          <input type="checkbox" name="on_stage" value="<%= c.name %>" class="peer sr-only" <%= on ? 'checked' : '' %> <%= narra ? 'disabled' : '' %>>
                          <span class="opcion-forge__caja" title="<%= c.relation || TIPOS[c.kind] %>">
                            <% if (c.kind === 'grupo') { %><i data-lucide="users" class="w-3 h-3"></i><% } %>
                            <%= c.name %><% if (narra) { %> <span class="text-[10px] uppercase tracking-widest">· lo cuenta</span><% } %>
                          </span>
                        </label>
                        <% if (!narra) { %>
                          <button type="button" class="<%= borrar %>" data-borrar-personaje="<%= c.name %>" data-usos="<%= (c.acts || []).join(',') %>"
                                  title="Borrar a «<%= c.name %>»" aria-label="Borrar el personaje «<%= c.name %>»"><i data-lucide="x" class="w-3 h-3"></i></button>
                        <% } %>
                      </span>
                    <% }) %>
                    <button type="button" class="btn-forge-outline-sm" data-personaje-nuevo><i data-lucide="plus" class="w-3 h-3"></i> Personaje</button>
                  </div>
                  <div class="hidden mt-3 space-y-2 border border-forge-border bg-forge-bg p-3" data-personaje-form>
                    <input type="text" data-p-nombre maxlength="60" placeholder="Quién (por ejemplo: el sereno)" class="w-full bg-forge-surface border border-forge-border px-2 py-1">
                    <input type="text" data-p-relacion maxlength="160" placeholder="Qué es para <%= narrador %>" class="w-full bg-forge-surface border border-forge-border px-2 py-1">
                    <select data-p-tipo class="w-full bg-forge-surface border border-forge-border px-2 py-1">
                      <% Object.entries(TIPOS).forEach(([id, label]) => { %><option value="<%= id %>" <%= id === 'sin_nombre' ? 'selected' : '' %>><%= label %></option><% }) %>
                    </select>
                    <button type="button" class="btn-forge-outline-sm w-full" data-personaje-guardar>Sumar personaje</button>
                  </div>
                </fieldset>
              </aside>
            </div>
            <input type="hidden" name="keep" value="<%= JSON.stringify({ seeds: a.seeds, payoffs: a.payoffs, decisions: a.decisions }) %>">
          </form>
        </li>
