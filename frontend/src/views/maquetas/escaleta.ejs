<%/*
  Spec-530 S0 — Maqueta: Escaleta. Una tarjeta por acto; los avisos del
  verificador van en la tarjeta que corresponde. Entrada: ESCALETA, ESCENARIOS,
  PERSONAJES, DECISIONES, PASOS, pasoActual.
*/%>
<% const totalAvisos = ESCALETA.reduce((n, a) => n + a.avisos.length, 0);
   const integradas = DECISIONES.filter(d => d.integrada).length; %>
<div class="max-w-5xl">
  <%- include('_cabecera') %>

  <header class="mb-8 max-w-3xl">
    <h2 class="font-serif text-3xl text-forge-accent mb-2">Escaleta</h2>
    <p class="text-forge-muted">Los cinco actos de tu historia antes de escribirla. Cambiá lo que quieras: el relato se genera a partir de esto.</p>
  </header>

  <%/* ── Resumen del verificador ────────────────────────────────────────── */%>
  <section class="grid md:grid-cols-2 gap-4 mb-10">
    <div class="bg-forge-surface border border-forge-border p-5">
      <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-3">Lo que decidiste en el taller · <%= integradas %>/<%= DECISIONES.length %> en la escaleta</h3>
      <ul class="space-y-2 text-sm">
        <% DECISIONES.forEach(d => { %>
          <li class="flex items-center gap-2 <%= d.integrada ? '' : 'text-forge-error' %>">
            <i data-lucide="<%= d.integrada ? 'check-circle-2' : 'alert-circle' %>" class="w-4 h-4 shrink-0 <%= d.integrada ? 'text-forge-success' : '' %>"></i>
            <%= d.nombre %><% if (!d.integrada) { %> — no aparece en ningún acto<% } %>
          </li>
        <% }) %>
      </ul>
    </div>
    <div class="bg-forge-surface border border-forge-border p-5">
      <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-3">Revisión de la IA</h3>
      <p class="text-sm mb-2"><span class="font-semibold text-forge-warning"><%= totalAvisos %> avisos</span> en las tarjetas de los actos.</p>
      <p class="text-sm text-forge-muted">Busca decisiones que faltan, hechos repetidos o fuera de lugar, y secretos que nunca se revelan. Los avisos son sugerencias: vos decidís.</p>
    </div>
  </section>

  <%/* ── Actos ───────────────────────────────────────────────────────────── */%>
  <ol class="space-y-8 mb-12">
    <% ESCALETA.forEach(a => { %>
      <li class="grid grid-cols-[3rem_1fr] gap-4">
        <%/* Riel: número + intensidad */%>
        <div class="flex flex-col items-center">
          <span class="w-10 h-10 rounded-full bg-forge-accent text-forge-on-accent font-serif text-lg flex items-center justify-center"><%= a.numero %></span>
          <span class="flex-1 w-px bg-forge-border mt-2"></span>
        </div>

        <article class="bg-forge-surface border border-forge-border">
          <header class="flex flex-wrap items-baseline justify-between gap-2 px-6 pt-5 pb-3 border-b border-forge-border">
            <h3 class="font-serif text-2xl">Acto <%= a.numero %> · <%= a.nombre %></h3>
            <span class="text-xs uppercase tracking-widest text-forge-muted">intensidad <%= a.intensidad %></span>
          </header>

          <% if (a.avisos.length) { %>
            <div class="mx-6 mt-4 border border-forge-warning-border bg-forge-warning-bg px-4 py-3 space-y-2">
              <% a.avisos.forEach(av => { %>
                <div class="flex items-start gap-3 text-sm text-forge-warning">
                  <i data-lucide="alert-triangle" class="w-4 h-4 shrink-0 mt-0.5"></i>
                  <p class="flex-1"><%= av %></p>
                  <button type="button" class="underline shrink-0">Aplicar</button>
                  <button type="button" class="shrink-0 opacity-75 hover:opacity-100">Ignorar</button>
                </div>
              <% }) %>
            </div>
          <% } %>

          <div class="grid lg:grid-cols-[1fr_18rem] gap-6 p-6">
            <%/* Columna principal: meta, hechos, cambio */%>
            <div>
              <label class="block text-xs uppercase tracking-widest text-forge-muted mb-1">Qué quiere José</label>
              <textarea rows="1" class="w-full [field-sizing:content] resize-none bg-forge-bg border border-forge-border px-3 py-2 mb-5"><%= a.meta %></textarea>

              <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Qué pasa</p>
              <ol class="space-y-2 mb-3">
                <% a.hechos.forEach((h, i) => { %>
                  <li class="group flex items-start gap-2">
                    <i data-lucide="grip-vertical" class="w-4 h-4 text-forge-muted mt-3 shrink-0 cursor-grab" title="Arrastrar para reordenar"></i>
                    <textarea rows="1" class="flex-1 [field-sizing:content] resize-none bg-forge-bg border border-forge-border px-3 py-2"><%= h %></textarea>
                    <button type="button" class="mt-2 text-forge-muted hover:text-forge-error opacity-0 group-hover:opacity-100" title="Quitar"><i data-lucide="x" class="w-4 h-4"></i></button>
                  </li>
                <% }) %>
              </ol>
              <button type="button" class="text-sm text-forge-accent inline-flex items-center gap-1 mb-5"><i data-lucide="plus" class="w-4 h-4"></i> Agregar hecho</button>

              <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Qué cambia</p>
              <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <textarea rows="1" class="flex-1 [field-sizing:content] resize-none bg-forge-bg border border-forge-border px-3 py-2" aria-label="Al empezar"><%= a.cambio.de %></textarea>
                <i data-lucide="arrow-right" class="w-4 h-4 text-forge-accent shrink-0 self-center"></i>
                <textarea rows="1" class="flex-1 [field-sizing:content] resize-none bg-forge-bg border border-forge-border px-3 py-2" aria-label="Al terminar"><%= a.cambio.a %></textarea>
              </div>
            </div>

            <%/* Columna lateral: dónde, reglas, hilos, secreto */%>
            <aside class="space-y-5 text-sm">
              <div>
                <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Dónde pasa</p>
                <div class="flex flex-wrap gap-2">
                  <% ESCENARIOS.forEach(e => { %>
                    <span class="px-2 py-1 border <%= e === a.escenario ? 'border-forge-accent bg-forge-accent text-forge-on-accent' : 'border-forge-border text-forge-muted' %>"><%= e %></span>
                  <% }) %>
                  <span class="px-2 py-1 border border-dashed border-forge-border text-forge-muted">+ nuevo</span>
                </div>
              </div>

              <div>
                <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Reglas en este acto</p>
                <% if (a.reglas.length) { a.reglas.forEach(r => { %>
                  <p class="border-l-2 border-forge-accent pl-3 mb-1"><%= r %></p>
                <% }) } else { %>
                  <p class="text-forge-muted italic">Ninguna</p>
                <% } %>
                <button type="button" class="text-forge-accent inline-flex items-center gap-1 mt-1"><i data-lucide="plus" class="w-3 h-3"></i> Regla</button>
              </div>

              <% if (a.siembra.length || a.cobra.length) { %>
                <div>
                  <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Hilos</p>
                  <% a.siembra.forEach(s => { %><p class="flex items-center gap-2 mb-1"><i data-lucide="sprout" class="w-4 h-4 text-forge-success"></i>Siembra: <%= s %></p><% }) %>
                  <% a.cobra.forEach(c => { %><p class="flex items-center gap-2 mb-1"><i data-lucide="link" class="w-4 h-4 text-forge-info"></i>Retoma: <%= c %></p><% }) %>
                </div>
              <% } %>

              <div>
                <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Se guarda para después</p>
                <p><%= a.seGuarda %></p>
              </div>

              <div>
                <p class="text-xs uppercase tracking-widest text-forge-muted mb-2">Personajes</p>
                <div class="flex flex-wrap gap-2">
                  <% PERSONAJES.forEach(p => { %><span class="px-2 py-1 bg-forge-bg border border-forge-border"><%= p %></span><% }) %>
                  <span class="px-2 py-1 border border-dashed border-forge-border text-forge-muted">+ personaje</span>
                </div>
              </div>
            </aside>
          </div>
        </article>
      </li>
    <% }) %>
  </ol>

  <%/* ── Acciones ───────────────────────────────────────────────────────── */%>
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-forge-border pt-6">
    <a href="/maquetas/taller" class="text-sm text-forge-muted hover:text-forge-accent inline-flex items-center gap-2"><i data-lucide="arrow-left" class="w-4 h-4"></i> Taller</a>
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" class="btn-forge-outline-sm"><i data-lucide="search-check" class="w-4 h-4"></i> Revisar con la IA <span class="normal-case tracking-normal text-forge-muted">≈ 45 s</span></button>
      <button type="button" class="btn-forge-sm"><i data-lucide="feather" class="w-4 h-4"></i> Generar relato <span class="normal-case tracking-normal">≈ 4 min</span></button>
    </div>
  </div>
</div>
