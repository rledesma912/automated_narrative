<%/*
  Spec-530 S0 — Maqueta: Dirección. Pocas decisiones, una por tarjeta, cada una
  con su «por qué importa». Entrada: DIRECCION, PASOS, pasoActual.
*/%>
<% const d = DIRECCION; %>
<div class="max-w-3xl">
  <%- include('_cabecera') %>

  <header class="mb-10">
    <h2 class="font-serif text-3xl text-forge-accent mb-2">¿Qué historia querés contar?</h2>
    <p class="text-forge-muted">Con esto alcanza para empezar. Después el asistente te va a hacer preguntas para llenar los huecos.</p>
  </header>

  <form class="space-y-6" onsubmit="return false">

    <%/* ── 1. Título y género ─────────────────────────────────────────── */%>
    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-4">El título y el tipo de horror</h3>
      <label class="block text-sm text-forge-muted mb-1" for="m-titulo">Título</label>
      <input id="m-titulo" type="text" value="<%= d.titulo %>"
             class="w-full bg-forge-bg border border-forge-border px-3 py-2 mb-4 focus:outline-none focus:border-forge-accent">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="m-genero">Tipo de horror</label>
          <select id="m-genero" class="w-full bg-forge-bg border border-forge-border px-3 py-2">
            <option selected><%= d.genero.label %></option>
          </select>
        </div>
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="m-subgenero">Estilo</label>
          <select id="m-subgenero" class="w-full bg-forge-bg border border-forge-border px-3 py-2">
            <option selected><%= d.subgenero.label %></option>
          </select>
        </div>
      </div>
    </section>

    <%/* ── 2. De qué trata ───────────────────────────────────────────── */%>
    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-1">¿De qué trata?</h3>
      <p class="text-sm text-forge-muted mb-4 flex gap-2"><i data-lucide="lightbulb" class="w-4 h-4 shrink-0 mt-0.5"></i>
        Contalo como se lo contarías a alguien en dos o tres frases. No hace falta ordenarlo en actos: eso lo hacemos después.</p>
      <textarea rows="4" class="w-full bg-forge-bg border border-forge-border px-3 py-2 leading-relaxed focus:outline-none focus:border-forge-accent"><%= d.deQueTrata %></textarea>
    </section>

    <%/* ── 3. Efecto buscado ─────────────────────────────────────────── */%>
    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-1">¿Qué querés que sienta quien lo escuche?</h3>
      <p class="text-sm text-forge-muted mb-4 flex gap-2"><i data-lucide="lightbulb" class="w-4 h-4 shrink-0 mt-0.5"></i>
        Es la brújula del asistente: las preguntas y la escaleta van a apuntar a este efecto.</p>
      <div class="grid sm:grid-cols-2 gap-3">
        <% d.efectos.forEach(e => { %>
          <label class="cursor-pointer">
            <input type="radio" name="efecto" class="peer sr-only" <%= e.id === d.efecto ? 'checked' : '' %>>
            <span class="block h-full border border-forge-border bg-forge-bg p-4 transition-colors
                         peer-checked:border-forge-accent peer-checked:bg-forge-accent/5 peer-focus-visible:ring-2 peer-focus-visible:ring-forge-accent">
              <span class="block font-semibold"><%= e.label %></span>
              <span class="block text-sm text-forge-muted"><%= e.ayuda %></span>
            </span>
          </label>
        <% }) %>
      </div>
    </section>

    <%/* ── 4. Cómo termina ───────────────────────────────────────────── */%>
    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-1">¿Cómo termina?</h3>
      <p class="text-sm text-forge-muted mb-4 flex gap-2"><i data-lucide="lightbulb" class="w-4 h-4 shrink-0 mt-0.5"></i>
        Si ya lo tenés decidido, marcalo: el asistente no te va a proponer otro final.</p>
      <textarea rows="2" class="w-full [field-sizing:content] bg-forge-bg border border-forge-border px-3 py-2 mb-3 focus:outline-none focus:border-forge-accent"><%= d.final %></textarea>
      <label class="inline-flex items-center gap-2 text-sm cursor-pointer">
        <input type="checkbox" class="accent-forge-accent w-4 h-4" <%= d.finalIntencional ? 'checked' : '' %>>
        Es así a propósito: no lo cambies
      </label>
    </section>

    <%/* ── 5. Protagonista y quién cuenta ────────────────────────────── */%>
    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-4">¿A quién le pasa y quién lo cuenta?</h3>
      <div class="grid sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="m-prota">Protagonista</label>
          <input id="m-prota" type="text" value="<%= d.protagonista.nombre %>" class="w-full bg-forge-bg border border-forge-border px-3 py-2">
        </div>
        <div>
          <label class="block text-sm text-forge-muted mb-1" for="m-quehace">¿Qué hace?</label>
          <input id="m-quehace" type="text" value="<%= d.protagonista.queHace %>" class="w-full bg-forge-bg border border-forge-border px-3 py-2">
        </div>
      </div>
      <label class="block text-sm text-forge-muted mb-1" for="m-narra">Quién lo cuenta</label>
      <select id="m-narra" class="w-full sm:w-1/2 bg-forge-bg border border-forge-border px-3 py-2">
        <option selected><%= d.narrador %> (el protagonista)</option>
        <option>Otro personaje…</option>
      </select>
    </section>

    <%/* ── 5b. Quiénes más aparecen ──────────────────────────────────── */%>
    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-1">¿Quiénes más aparecen? <span class="ml-1 text-xs uppercase tracking-widest text-forge-muted font-sans">opcional</span></h3>
      <p class="text-sm text-forge-muted mb-4 flex gap-2"><i data-lucide="lightbulb" class="w-4 h-4 shrink-0 mt-0.5"></i>
        <span>Anotá cómo los ve quien cuenta la historia («mi mamá», «el patrón»): así la voz los llama bien.
        Si son muchos parecidos, cargalos como <strong>grupo</strong> («las familias del galpón»). Los que falten los podés sumar después, en cada acto.</span></p>
      <div class="hidden sm:grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)_8rem_1.5rem] gap-3 text-xs uppercase tracking-widest text-forge-muted mb-2">
        <span>Quién</span><span>Qué es para <%= d.narrador %></span><span>Tipo</span><span></span>
      </div>
      <ul class="space-y-3 mb-3">
        <% PERSONAJES.filter(p => !p.narra).forEach(p => { %>
          <li class="grid sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_8rem_1.5rem] gap-3 items-center">
            <input type="text" value="<%= p.nombre %>" class="bg-forge-bg border border-forge-border px-3 py-2" aria-label="Quién">
            <input type="text" value="<%= p.quienEs %>" class="bg-forge-bg border border-forge-border px-3 py-2" aria-label="Qué es para quien narra">
            <select class="bg-forge-bg border border-forge-border px-2 py-2" aria-label="Tipo" title="<%= TIPOS_PERSONAJE[p.tipo].ayuda %>">
              <% Object.entries(TIPOS_PERSONAJE).forEach(([id, t]) => { %>
                <option <%= id === p.tipo ? 'selected' : '' %>><%= t.label %></option>
              <% }) %>
            </select>
            <button type="button" class="text-forge-muted hover:text-forge-error justify-self-center" title="Quitar"><i data-lucide="x" class="w-4 h-4"></i></button>
          </li>
        <% }) %>
      </ul>
      <button type="button" class="text-sm text-forge-accent inline-flex items-center gap-1"><i data-lucide="plus" class="w-4 h-4"></i> Agregar persona o grupo</button>
    </section>

    <%/* ── 6. Cómo lo cuenta ─────────────────────────────────────────── */%>
    <section class="bg-forge-surface border border-forge-border p-6">
      <h3 class="font-serif text-xl mb-1">¿Cómo lo cuenta?</h3>
      <p class="text-sm text-forge-muted mb-4 flex gap-2"><i data-lucide="lightbulb" class="w-4 h-4 shrink-0 mt-0.5"></i>
        Elegí cómo suena la voz. Cada opción tiene un ejemplo de cómo arrancaría.</p>
      <div class="space-y-3">
        <% d.comoLoCuenta.forEach(c => { %>
          <label class="cursor-pointer block">
            <input type="radio" name="como" class="peer sr-only" <%= c.id === d.comoLoCuentaElegido ? 'checked' : '' %>>
            <span class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 border border-forge-border bg-forge-bg p-4 transition-colors
                         peer-checked:border-forge-accent peer-checked:bg-forge-accent/5 peer-focus-visible:ring-2 peer-focus-visible:ring-forge-accent">
              <span class="font-semibold sm:w-56 shrink-0"><%= c.label %></span>
              <span class="prose-forge italic text-forge-muted"><%= c.ejemplo %></span>
            </span>
          </label>
        <% }) %>
      </div>
    </section>

    <%/* ── 7. La amenaza (opcional) ──────────────────────────────────── */%>
    <details class="bg-forge-surface border border-forge-border p-6 group">
      <summary class="cursor-pointer list-none flex items-center justify-between">
        <span>
          <span class="font-serif text-xl">La amenaza</span>
          <span class="ml-2 text-xs uppercase tracking-widest text-forge-muted">opcional</span>
        </span>
        <i data-lucide="chevron-down" class="w-5 h-5 text-forge-muted transition-transform group-open:rotate-180"></i>
      </summary>
      <p class="text-sm text-forge-muted mt-3 mb-4">Si tu historia tiene un ser, un lugar o una fuerza que acecha, describilo acá: qué quiere, cómo se manifiesta y qué no puede hacer. Si preferís, dejalo para después.</p>
      <div class="grid sm:grid-cols-2 gap-4 opacity-60">
        <input type="text" placeholder="Nombre (ej.: la mujer del asiento 32)" class="bg-forge-bg border border-forge-border px-3 py-2">
        <select class="bg-forge-bg border border-forge-border px-3 py-2"><option>Qué es: fantasma</option></select>
      </div>
    </details>

    <%/* ── Acciones: guardar es automático; analizar, siempre explícito ── */%>
    <div class="sticky bottom-0 -mx-1 flex flex-wrap items-center justify-between gap-4 border-t border-forge-border bg-forge-bg shadow-[0_-8px_16px_-12px] shadow-forge-text/30 px-1 py-4">
      <span class="text-sm text-forge-success inline-flex items-center gap-2" aria-live="polite">
        <i data-lucide="check" class="w-4 h-4"></i> Guardado hace un momento
      </span>
      <button type="button" class="btn-forge-sm"
              data-maqueta-analizar
              data-titulo="Interpretando la historia…"
              data-detalle="La IA está leyendo tu historia para ver qué le falta y qué preguntarte."
              data-eta="≈ 40 s"
              data-destino="/maquetas/taller">
        <i data-lucide="sparkles" class="w-4 h-4"></i> Analizar mi historia <span class="normal-case tracking-normal">· ≈ 40 s</span>
      </button>
    </div>
  </form>
</div>

<%- include('_analizando') %>
