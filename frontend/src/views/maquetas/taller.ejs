<%/*
  Spec-530 S0 — Maqueta: Taller. La IA evalúa criterios y pregunta solo por los
  huecos; el usuario responde, elige una opción, delega o marca «intencional».
  Entrada: TALLER, SEMAFORO, PASOS, pasoActual.
*/%>
<% const t = TALLER;
   const abiertas = t.preguntas.filter(p => p.estado === 'falta' || p.estado === 'parcial');
   const resueltas = t.preguntas.filter(p => !(p.estado === 'falta' || p.estado === 'parcial')); %>
<div class="max-w-3xl">
  <%- include('_cabecera') %>

  <header class="mb-8">
    <h2 class="font-serif text-3xl text-forge-accent mb-2">Taller</h2>
    <p class="text-forge-muted">El asistente leyó tu historia y te pregunta solo lo que le falta para que tenga tensión. Respondé lo que quieras; nada es obligatorio.</p>
  </header>

  <%/* ── Estado: semáforo por criterio + motivo de fin ─────────────────── */%>
  <section class="bg-forge-surface border border-forge-border p-6 mb-8">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xs uppercase tracking-widest text-forge-muted">Estado de la historia</h3>
      <span class="text-xs text-forge-muted">Ronda <%= t.ronda %> de <%= t.maxRondas %></span>
    </div>
    <ul class="flex flex-wrap gap-2 mb-5">
      <% t.preguntas.forEach(p => { const s = SEMAFORO[p.estado]; %>
        <li class="inline-flex items-center gap-2 border px-3 py-1 text-sm <%= s.cls %>" title="<%= s.label %>">
          <span class="w-2 h-2 rounded-full <%= s.dot %>"></span><%= p.nombre %>
        </li>
      <% }) %>
    </ul>
    <p class="flex gap-2 text-sm"><i data-lucide="info" class="w-4 h-4 text-forge-info shrink-0 mt-0.5"></i><%= t.fin.texto %></p>
  </section>

  <%/* ── Preguntas abiertas ─────────────────────────────────────────────── */%>
  <h3 class="font-serif text-xl mb-4">Preguntas abiertas</h3>
  <div class="space-y-6 mb-12">
    <% abiertas.forEach((p, n) => { const s = SEMAFORO[p.estado]; %>
      <article class="bg-forge-surface border border-forge-border p-6">
        <div class="flex items-center justify-between gap-4 mb-3">
          <span class="text-xs uppercase tracking-widest text-forge-muted"><%= p.nombre %></span>
          <span class="inline-flex items-center gap-2 border px-2 py-0.5 text-xs <%= s.cls %>">
            <span class="w-1.5 h-1.5 rounded-full <%= s.dot %>"></span><%= s.label %>
          </span>
        </div>
        <p class="font-serif text-xl mb-2"><%= p.pregunta %></p>
        <p class="text-sm text-forge-muted mb-5 flex gap-2"><i data-lucide="lightbulb" class="w-4 h-4 shrink-0 mt-0.5"></i><%= p.porQue %></p>

        <fieldset class="space-y-2 mb-4">
          <legend class="sr-only">Opciones</legend>
          <% p.opciones.forEach(o => { %>
            <label class="cursor-pointer block">
              <input type="radio" name="op-<%= p.criterio %>" class="peer sr-only">
              <span class="flex items-center gap-3 border border-forge-border bg-forge-bg px-4 py-3 transition-colors
                           peer-checked:border-forge-accent peer-checked:bg-forge-accent/5 peer-focus-visible:ring-2 peer-focus-visible:ring-forge-accent">
                <i data-lucide="circle" class="w-4 h-4 text-forge-muted shrink-0"></i><%= o %>
              </span>
            </label>
          <% }) %>
          <label class="cursor-pointer block">
            <input type="radio" name="op-<%= p.criterio %>" class="peer sr-only">
            <span class="block border border-dashed border-forge-border bg-forge-bg px-4 py-3 text-forge-muted
                         peer-checked:border-forge-accent peer-checked:text-forge-text">
              <span class="flex items-center gap-3"><i data-lucide="pencil" class="w-4 h-4 shrink-0"></i>Escribir la mía…</span>
            </span>
          </label>
        </fieldset>

        <div class="flex flex-wrap items-center gap-3">
          <button type="button" class="btn-forge-sm">Guardar respuesta</button>
          <button type="button" class="btn-forge-outline-sm" title="El asistente elige una opción que encaje con tu dirección">
            <i data-lucide="sparkles" class="w-4 h-4"></i> Decidí vos
          </button>
          <button type="button" class="btn-forge-outline-sm" title="Queda como está y no se vuelve a preguntar">
            <i data-lucide="lock" class="w-4 h-4"></i> Es así a propósito
          </button>
        </div>
      </article>
    <% }) %>
  </div>

  <%/* ── Resueltas ──────────────────────────────────────────────────────── */%>
  <h3 class="font-serif text-xl mb-4">Ya resuelto</h3>
  <ul class="space-y-3 mb-12">
    <% resueltas.forEach(p => { const s = SEMAFORO[p.estado]; %>
      <li class="bg-forge-surface border border-forge-border px-5 py-4 flex items-start gap-4">
        <span class="w-2.5 h-2.5 rounded-full mt-2 shrink-0 <%= s.dot %>" title="<%= s.label %>"></span>
        <div class="flex-1">
          <p class="text-xs uppercase tracking-widest text-forge-muted mb-1"><%= p.nombre %><% if (p.estado === 'intencional') { %> · <i data-lucide="lock" class="w-3 h-3 inline"></i> a propósito<% } %></p>
          <p><%= p.respuesta %></p>
        </div>
        <button type="button" class="text-sm text-forge-muted hover:text-forge-accent shrink-0">Cambiar</button>
      </li>
    <% }) %>
  </ul>

  <%/* ── Acciones ───────────────────────────────────────────────────────── */%>
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-forge-border pt-6">
    <a href="/maquetas/direccion" class="text-sm text-forge-muted hover:text-forge-accent inline-flex items-center gap-2"><i data-lucide="arrow-left" class="w-4 h-4"></i> Dirección</a>
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" class="btn-forge-outline-sm"><i data-lucide="refresh-cw" class="w-4 h-4"></i> Analizar de nuevo <span class="normal-case tracking-normal text-forge-muted">≈ 40 s</span></button>
      <a href="/maquetas/escaleta" class="btn-forge-sm">Pasar a la escaleta <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
    </div>
  </div>
</div>
