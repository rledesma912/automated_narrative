<%
/*
 * Variables de entrada:
 *   coreHealth: { reachable: boolean, status?: string, error?: string, checks?: Record<string, string> }
 *   env: { PORT: string, CORE_API_URL: string, NODE_ENV: string, DATABASE_URL: string }
 *   llmInfo: { provider: string, model: string } | null
 */
%>
<div class="max-w-2xl">
  <h2 class="font-serif text-2xl text-forge-accent mb-1">Panel de Diagnóstico</h2>
  <p class="text-forge-muted text-xs uppercase tracking-widest mb-10">Slice 1 — Infraestructura</p>

  <section class="mb-8">
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-3 border-b border-forge-border pb-2">
      Core API
    </h3>
    <table class="w-full text-sm">
      <tr class="border-b border-forge-border">
        <td class="py-2 pr-4 text-forge-muted w-40">Estado</td>
        <td class="py-2">
          <% if (coreHealth.reachable) { %>
            <span class="px-2 py-0.5 bg-green-950 text-green-400 text-xs font-bold rounded">ONLINE</span>
          <% } else { %>
            <span class="px-2 py-0.5 bg-red-950 text-red-400 text-xs font-bold rounded">OFFLINE</span>
          <% } %>
        </td>
      </tr>
      <tr class="border-b border-forge-border">
        <td class="py-2 pr-4 text-forge-muted">Endpoint</td>
        <td class="py-2"><%= env.CORE_API_URL %></td>
      </tr>
      <% if (coreHealth.reachable && coreHealth.checks) { %>
      <tr class="border-b border-forge-border">
        <td class="py-2 pr-4 text-forge-muted">Health</td>
        <td class="py-2 <%= coreHealth.checks.sqlite?.includes('error') ? 'text-red-400' : 'text-green-400' %>">
          <%= coreHealth.status %>
        </td>
      </tr>
      <% } %>
    </table>
  </section>

  <% if (coreHealth.reachable && coreHealth.checks) { %>
  <section class="mb-8">
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-3 border-b border-forge-border pb-2">
      Base de Datos
    </h3>
    <table class="w-full text-sm">
      <tr class="border-b border-forge-border">
        <td class="py-2 pr-4 text-forge-muted w-40">Estado</td>
        <td class="py-2 <%= coreHealth.checks.sqlite?.includes('error') ? 'text-red-400' : 'text-green-400' %>">
          <%= coreHealth.checks.sqlite?.replace('error: ', '') || 'OK' %>
        </td>
      </tr>
      <tr class="border-b border-forge-border">
        <td class="py-2 pr-4 text-forge-muted">Path</td>
        <td class="py-2 font-mono text-xs"><%= env.DATABASE_URL %></td>
      </tr>
    </table>
  </section>

  <section class="mb-8">
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-3 border-b border-forge-border pb-2">
      LLM Configuración
    </h3>
    <table class="w-full text-sm">
      <tr class="border-b border-forge-border">
        <td class="py-2 pr-4 text-forge-muted w-40">Provider</td>
        <td class="py-2"><%= coreHealth.checks.provider %></td>
      </tr>
      <tr class="border-b border-forge-border">
        <td class="py-2 pr-4 text-forge-muted">Modelo</td>
        <td class="py-2 font-mono text-xs"><%= coreHealth.active_profile %></td>
      </tr>
    </table>
  </section>
  <% } %>

  <section>
    <h3 class="text-xs uppercase tracking-widest text-forge-muted mb-3 border-b border-forge-border pb-2">
      Variables de Entorno
    </h3>
    <table class="w-full text-sm">
      <% Object.entries(env).forEach(([key, val]) => { %>
      <tr class="border-b border-forge-border">
        <td class="py-2 pr-4 text-forge-muted w-40"><%= key %></td>
        <td class="py-2 <%= key === 'DATABASE_URL' ? 'font-mono text-xs' : '' %>"><%= val %></td>
      </tr>
      <% }) %>
    </table>
  </section>
</div>
