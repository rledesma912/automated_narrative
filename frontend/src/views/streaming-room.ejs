<%
/*
 * Variables de entrada:
 *   storyId:        string
 *   activeJobId:    string | null — job en curso (Spec-460): la sala se ata sola
 *   storyStatus:    string — 'processing' | 'completed' | 'failed' | 'draft'
 *   story:          object | null
 *   beats:          array  — beats cargados de DB (modo lectura)
 *   regenerateMode: boolean — true si llegó con ?escribir=1 (o ?regenerate=1) y status=completed (Spec-219)
 *   startMode:      boolean — true si llegó con ?escribir=1 y es un borrador o falló (Spec-630 B14)
 */
%>

<% if (!activeJobId && storyStatus !== 'processing' && !regenerateMode && !locals.startMode) { %>
<%/* ══════════════════════════════════════════════════════════════════════════ */%>
<%/* MODO LECTURA — historia completed o failed                               */%>
<%/* ══════════════════════════════════════════════════════════════════════════ */%>
<%
  const READ_STATUS = {
    completed: { text: 'Lista', cls: 'text-forge-success', icon: 'check-circle' },
    failed:    { text: 'Error',      cls: 'text-forge-error',   icon: 'alert-triangle' },
    draft:     { text: 'Borrador',   cls: 'text-forge-warning', icon: 'file' },
  };
  const rs = READ_STATUS[storyStatus] || READ_STATUS['draft'];
%>
<div class="max-w-4xl mx-auto">

  <%/* ── Header ───────────────────────────────────────────── */%>
  <div class="flex items-center justify-between mb-10">
    <div>
      <h2 class="font-serif text-3xl text-forge-accent"><%= story ? story.title : 'Historia' %></h2>
      <p class="text-forge-muted text-sm uppercase tracking-widest mt-2">El relato, acto por acto</p>
    </div>
    <div class="flex items-center gap-2 px-4 py-2 border border-forge-border text-sm font-bold <%= rs.cls %>">
      <i data-lucide="<%= rs.icon %>" class="w-4 h-4"></i>
      <%= rs.text %>
    </div>
  </div>

  <%/* ── Beats cargados ─────────────────────────────────────── */%>
  <% if (beats && beats.length > 0) { %>
    <div class="space-y-6 mb-10">
      <% beats.forEach(function(b) { %>
        <% if (b.status === 'completed' && b.content) { %>
          <div class="border border-forge-border bg-forge-surface p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full bg-forge-accent flex items-center justify-center shrink-0">
                <i data-lucide="check" class="w-4 h-4 text-forge-bg"></i>
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-widest text-forge-accent">Acto <%= b.beat_number || b.number %></span>
                <% if (b.summary) { %>
                  <p class="text-xs text-forge-muted mt-0.5"><%= b.summary %></p>
                <% } %>
              </div>
            </div>
            <p class="prose-forge whitespace-pre-wrap"><%= b.content %></p>
          </div>
        <% } %>
      <% }); %>
    </div>
  <% } else { %>
    <div class="border border-forge-border bg-forge-surface p-12 text-center text-forge-muted mb-10">
      <i data-lucide="file-x" class="w-10 h-10 mx-auto mb-3 opacity-40"></i>
      <p class="text-sm">Todavía no hay actos escritos.</p>
    </div>
  <% } %>

  <%/* ── Acciones ────────────────────────────────────────────── */%>
  <div class="flex items-center gap-4 flex-wrap pt-6 border-t border-forge-border">
    <a href="/galeria"
       class="flex items-center gap-2 text-sm text-forge-muted hover:text-forge-text transition-colors">
      <i data-lucide="arrow-left" class="w-4 h-4"></i> Mis historias
    </a>
    <% if (story) { %>
      <%/* Spec-630 B12: la ficha se fue; se vuelve a «Los actos». */%>
      <a href="<%= rutas.editarHref(storyId) %>" class="btn-forge-outline">
        <i data-lucide="edit-3" class="w-4 h-4"></i> Editar
      </a>
      <% if (storyStatus === 'completed') { %>
        <a href="/generar/stream/<%= storyId %>?escribir=1" class="btn-forge-sm">
          <i data-lucide="refresh-cw" class="w-4 h-4"></i> Regenerar historia
        </a>
      <% } else if (storyStatus === 'failed') { %>
        <form method="POST" action="/historia/<%= storyId %>/generar">
          <button type="submit" class="btn-forge-sm">
            <i data-lucide="refresh-cw" class="w-4 h-4"></i> Regenerar historia
          </button>
        </form>
      <% } else if (storyStatus === 'draft') { %>
        <%/* Spec-630 B14: un borrador se empieza a escribir acá (Mis historias ya no lo lanza). */%>
        <a href="/generar/stream/<%= storyId %>?escribir=1" class="btn-forge-sm">
          <i data-lucide="feather" class="w-4 h-4"></i> Escribir el relato
        </a>
      <% } %>
    <% } %>
  </div>

</div>

<% } else { %>
<%/* ══════════════════════════════════════════════════════════════════════════ */%>
<%/* MODO SSE — generación activa (job en curso) o por iniciar                 */%>
<%/* ══════════════════════════════════════════════════════════════════════════ */%>

<%/* Spec-460: la sala tiene su propia conexión SSE (detalle del job): sin canal global. */%>
<div data-forge-no-global-events hidden></div>
<div class="max-w-4xl mx-auto" id="streaming-root">

  <%/* Spec-630 B18: también acá se puede volver (irse no corta la generación). Sin
       hx-boost: una navegación completa cierra la conexión SSE de la sala. */%>
  <nav class="flex items-center gap-6 mb-8 text-sm" aria-label="Volver" data-sala-volver>
    <a href="/galeria" hx-boost="false" class="flex items-center gap-2 text-forge-muted hover:text-forge-text transition-colors">
      <i data-lucide="arrow-left" class="w-4 h-4"></i> Mis historias
    </a>
    <a href="<%= rutas.editarHref(storyId) %>" hx-boost="false" class="flex items-center gap-2 text-forge-muted hover:text-forge-text transition-colors">
      <i data-lucide="edit-3" class="w-4 h-4"></i> Editar
    </a>
  </nav>

  <%/* ── Header ────────────────────────────────────────── */%>
  <div class="flex items-center justify-between mb-12">
    <div>
      <h2 class="font-serif text-3xl text-forge-accent">Escribiendo tu relato</h2>
      <p class="text-forge-muted text-sm uppercase tracking-widest mt-2" id="status-line">
        Conectando…
      </p>
      <%/* Spec-510: tiempo restante (lo completa /js/streaming-room.js con /js/eta.js). */%>
      <p class="text-forge-muted text-xs mt-1" id="eta-line" aria-live="polite"></p>
      </div>
      <div id="connection-badge" class="chip-forge chip-forge--md">
      <span id="spinner-icon" class="hidden"><i data-lucide="loader" class="w-4 h-4 animate-spin"></i></span>
      <span id="badge-text">Iniciando</span>
      </div>
  </div>

  <%/* ── Fases de Avance (Círculos Vistosos) ──────────────── */%>
  <div class="flex items-start justify-between mb-16 px-4" id="beat-dots">
    <% 
      const phases = [
        { id: 1, label: 'Cómo empieza' },
        { id: 2, label: 'Se complica' },
        { id: 3, label: 'El peor momento' },
        { id: 4, label: 'Qué hace después' },
        { id: 5, label: 'Cómo termina' }
      ];
    %>
    <% phases.forEach(p => { %>
      <div class="flex flex-col items-center gap-4 flex-1 relative">
        <% if (p.id < 5) { %>
          <div class="absolute top-6 left-[60%] right-[-40%] h-0.5 bg-forge-border z-0" id="line-<%= p.id %>"></div>
        <% } %>
        <div id="dot-<%= p.id %>"
             class="w-12 h-12 rounded-full border-4 border-forge-border bg-forge-surface flex items-center justify-center z-10 transition-all duration-500 shadow-lg">
          <span class="text-sm font-bold text-forge-muted"><%= p.id %></span>
        </div>
        <span class="text-[10px] uppercase tracking-widest text-forge-muted font-bold" id="label-<%= p.id %>">
          <%= p.label %>
        </span>
      </div>
    <% }) %>
  </div>

  <%/* ── Botón iniciar (visible hasta que el usuario haga click) ─ */%>
  <div id="start-panel" class="<%= activeJobId ? 'hidden ' : '' %>flex flex-col items-center justify-center py-24 gap-8">
    <div class="text-center max-w-2xl">
      <% if (regenerateMode) { %>
        <%/* Spec-630 B19: se llama «Regenerar», como en el resto del sitio. */%>
        <p class="text-forge-text text-2xl font-serif mb-6">¿Regeneramos la historia?</p>
        <%/* Spec-510: cuánto tarda y que no hace falta quedarse mirando. */%>
        <p class="text-sm text-forge-muted mb-8" data-start-estimate>
          <% if (locals.estimateLabels && locals.estimateLabels.full_generation) { %>Tarda <%= locals.estimateLabels.full_generation %>. <% } %>Podés cerrar la pestaña: la IA sigue escribiendo.
        </p>
        <%/* Spec-630 B20: regenerar crea una versión nueva; no se pierde nada. */%>
        <div class="nota-forge nota-forge--info mb-8 text-left" data-version-nueva>
          <i data-lucide="info" class="nota-forge__icono"></i>
          <p class="leading-relaxed">
            Se escribe una versión nueva con lo que tenés en «Los actos». Las versiones que ya tenés quedan en «El relato».
          </p>
        </div>
        <button type="button" onclick="initiateRegeneration()" class="btn-forge-lg group"
                data-generation-trigger data-story-id="<%= storyId %>" data-busy-label="Arrancando…">
          <i data-lucide="refresh-cw" class="w-6 h-6 group-hover:rotate-12 transition-transform"></i>
          Regenerar historia
        </button>
      <% } else { %>
        <p class="text-forge-text text-2xl font-serif mb-6">¿Empezamos a escribir?</p>
        <%/* Spec-510: cuánto tarda y que no hace falta quedarse mirando. */%>
        <p class="text-sm text-forge-muted mb-8" data-start-estimate>
          <% if (locals.estimateLabels && locals.estimateLabels.full_generation) { %>Tarda <%= locals.estimateLabels.full_generation %>. <% } %>Podés cerrar la pestaña: la IA sigue escribiendo.
        </p>
        <button type="button" onclick="initiateGeneration()" class="btn-forge-lg group"
                data-generation-trigger data-story-id="<%= storyId %>" data-busy-label="Arrancando…">
          <i data-lucide="sparkles" class="w-6 h-6 group-hover:rotate-12 transition-transform"></i>
          Escribir el relato
        </button>
      <% } %>
    </div>
  </div>

  <%/* ── Log de progreso estilo CLI ────────────────────── */%>
  <%/* Bug 7: logs van ANTES del spinner para que el spinner quede visualmente */%>
  <%/* debajo durante toda la generación (se oculta solo en done/error/cancel). */%>
  <div id="log-container"
       class="hidden font-mono text-sm space-y-2 bg-forge-surface border border-forge-border p-8 mb-8 shadow-inner">
  </div>

  <%/* ── Spinner (oculto hasta iniciar; permanece hasta done/error) ─────── */%>
  <div id="initial-spinner" class="hidden flex flex-col items-center justify-center py-12 gap-6 mb-12">
    <div class="relative w-20 h-20">
      <div class="absolute inset-0 border-4 border-forge-border rounded-full opacity-20"></div>
      <div id="spinner-spin" class="absolute inset-0 border-4 border-t-forge-accent rounded-full"></div>
      <i id="sparkles-icon" data-lucide="sparkles" class="absolute inset-0 m-auto w-8 h-8 text-forge-accent"></i>
    </div>
    <div class="text-center">
      <p class="text-forge-text text-lg font-serif mb-2">Escribiendo tu relato…</p>
      <p id="processing-text" class="text-forge-muted text-xs uppercase tracking-widest">
        La IA está escribiendo, acto por acto
      </p>
    </div>
    <%/* Spec-460: cancelar detiene el job en el servidor */%>
    <button id="cancel-btn" type="button" onclick="cancelGeneration()"
            class="flex items-center gap-2 text-xs uppercase tracking-widest text-forge-muted hover:text-forge-error transition-colors">
      <i data-lucide="square" class="w-3 h-3"></i> Cancelar
    </button>
  </div>

  <%/* ── Paneles error/done (Spec-318 §9.D — extraídos a partials) ── */%>
  <%- include('partials/streaming_error_panel') %>

  <%- include('partials/streaming_done_panel', { storyId }) %>
</div>

<%/* Spec-318 §9.C — variables inyectadas desde el server, lógica en /js/streaming-room.js */%>
<script>
  window.STORY_ID      = "<%= storyId %>";
  window.TOTAL_BEATS   = 5;
  window.ACTIVE_JOB_ID = <%- JSON.stringify(activeJobId || null) %>;
</script>
<script src="/js/streaming-room.js?v=<%= locals.assetVersion || '' %>" defer></script>

<% } %>
