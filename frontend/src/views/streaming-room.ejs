<%
/*
 * Variables de entrada:
 *   storyId:       string
 *   coreStreamUrl: string — URL del endpoint SSE del Core Python
 */
%>

<div class="max-w-3xl" id="streaming-root">

  <%/* ── Header ────────────────────────────────────────── */%>
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="font-serif text-2xl text-forge-accent">Sala de Generación</h2>
      <p class="text-forge-muted text-xs uppercase tracking-widest mt-1" id="status-line">
        Conectando con el sistema...
      </p>
    </div>
    <div id="connection-badge"
         class="px-3 py-1 text-xs font-bold rounded border border-forge-border text-forge-muted">
      INICIANDO
    </div>
  </div>

  <%/* ── Progress bar ───────────────────────────────────── */%>
  <div class="w-full bg-forge-surface border border-forge-border h-1 mb-8">
    <div id="progress-bar" class="h-1 bg-forge-accent transition-all duration-700" style="width: 0%"></div>
  </div>

  <%/* ── Beat dots ──────────────────────────────────────── */%>
  <div class="flex gap-3 mb-10" id="beat-dots">
    <% for (let i = 1; i <= 5; i++) { %>
      <div id="dot-<%= i %>"
           class="w-3 h-3 rounded-full border-2 border-forge-border bg-transparent transition-all duration-300"
           title="Beat <%= i %>"></div>
    <% } %>
  </div>

  <%/* ── Beats container ────────────────────────────────── */%>
  <div id="beats-container" class="space-y-8"></div>

  <%/* ── Error panel (oculto por defecto) ──────────────── */%>
  <div id="error-panel" class="hidden mt-8 border border-red-900 bg-red-950 p-5">
    <div class="flex items-center gap-2 mb-2">
      <i data-lucide="alert-triangle" class="w-4 h-4 text-red-400"></i>
      <span class="text-red-400 text-sm font-bold">Conexión interrumpida</span>
    </div>
    <p id="error-msg" class="text-red-300 text-sm mb-4"></p>
    <div class="flex gap-3">
      <button onclick="retryStream()"
              class="px-4 py-2 bg-forge-accent text-forge-text text-xs uppercase tracking-widest hover:opacity-80">
        Reintentar
      </button>
      <a href="/galeria"
         class="px-4 py-2 border border-forge-border text-forge-muted text-xs uppercase tracking-widest hover:text-forge-text">
        Ver galería
      </a>
    </div>
  </div>

  <%/* ── Done panel (oculto por defecto) ───────────────── */%>
  <div id="done-panel" class="hidden mt-8 border border-forge-border bg-forge-surface p-5">
    <div class="flex items-center gap-2 mb-2">
      <i data-lucide="check-circle" class="w-4 h-4 text-green-400"></i>
      <span class="text-green-400 text-sm font-bold">Historia completada</span>
    </div>
    <a href="/galeria"
       class="inline-flex items-center gap-2 mt-3 px-5 py-2 bg-forge-accent text-forge-text text-sm
              uppercase tracking-widest hover:opacity-80">
      <i data-lucide="library" class="w-4 h-4"></i> Ver en Galería
    </a>
  </div>
</div>

<script>
  const STREAM_URL  = "<%= coreStreamUrl %>";
  const STORY_ID    = "<%= storyId %>";
  const TOTAL_BEATS = 5;
  let   beatCount   = 0;
  let   es          = null;

  function setBadge(text, color) {
    const badge = document.getElementById("connection-badge");
    badge.textContent = text;
    badge.className = `px-3 py-1 text-xs font-bold rounded border ${color}`;
  }

  function setStatus(msg) {
    document.getElementById("status-line").textContent = msg;
  }

  function setProgress(pct) {
    document.getElementById("progress-bar").style.width = `${pct}%`;
  }

  function markDot(num, state) {
    const dot = document.getElementById(`dot-${num}`);
    if (!dot) return;
    if (state === "active") {
      dot.className = "w-3 h-3 rounded-full border-2 border-forge-accent bg-transparent animate-pulse";
    } else if (state === "done") {
      dot.className = "w-3 h-3 rounded-full border-2 border-forge-accent bg-forge-accent";
    }
  }

  function appendBeat(number, content) {
    const container = document.getElementById("beats-container");
    const el = document.createElement("article");
    el.id = `beat-${number}`;
    el.className = "border-l-2 border-forge-accent pl-5";
    el.innerHTML = `
      <p class="text-xs uppercase tracking-widest text-forge-muted mb-3">Beat ${number}</p>
      <div class="text-forge-text text-sm leading-relaxed font-serif whitespace-pre-wrap">${escapeHtml(content)}</div>
    `;
    container.appendChild(el);
    el.scrollIntoView({ behavior: "smooth", block: "end" });
    lucide.createIcons();
  }

  function escapeHtml(str) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  function showError(msg) {
    setBadge("ERROR", "border-red-900 text-red-400");
    document.getElementById("error-msg").textContent = msg;
    document.getElementById("error-panel").classList.remove("hidden");
    if (es) { es.close(); es = null; }
  }

  function showDone() {
    setBadge("COMPLETO", "border-green-900 text-green-400");
    setStatus("Historia generada con éxito");
    setProgress(100);
    document.getElementById("done-panel").classList.remove("hidden");
    if (es) { es.close(); es = null; }
  }

  function retryStream() {
    document.getElementById("error-panel").classList.add("hidden");
    startStream();
  }

  function startStream() {
    setBadge("CONECTANDO", "border-forge-border text-forge-muted");
    setStatus("Conectando con el sistema...");

    es = new EventSource(STREAM_URL);

    es.addEventListener("status", (e) => {
      const d = JSON.parse(e.data);
      setStatus(d.msg);
    });

    es.addEventListener("beat_start", (e) => {
      const d = JSON.parse(e.data);
      setBadge("GENERANDO", "border-forge-accent text-forge-accent");
      setStatus(`Narrando beat ${d.number} de ${TOTAL_BEATS}...`);
      markDot(d.number, "active");
      setProgress(((d.number - 1) / TOTAL_BEATS) * 100);
    });

    es.addEventListener("beat_done", (e) => {
      const d = JSON.parse(e.data);
      beatCount = d.number;
      markDot(d.number, "done");
      appendBeat(d.number, d.content);
      setProgress((d.number / TOTAL_BEATS) * 100);
    });

    // Punto 2: heartbeat ignorado en UI — mantiene el canal abierto
    es.addEventListener("heartbeat", () => { /* canal vivo, sin acción visual */ });

    es.addEventListener("done", () => { showDone(); });

    // Punto 5: error a mitad de stream (event: "error" del backend)
    // Nota: "error" en EventSource es reservado para fallos de conexión.
    // sse-starlette emite event type "error" → se captura aquí como stream_error.
    es.addEventListener("stream_error", (e) => {
      try {
        const d = JSON.parse(e.data);
        showError(d.msg ?? "Error desconocido en el pipeline");
      } catch {
        showError("Error de conexión con el servidor");
      }
    });

    es.onerror = () => {
      if (beatCount === TOTAL_BEATS) { showDone(); return; }
      showError("Conexión interrumpida. El servidor no responde.");
    };
  }

  // Punto 5: verificar /health antes de conectar
  const HEALTH_URL = STREAM_URL.replace(/\/stories\/.*/, "/health");
  fetch(HEALTH_URL)
    .then(r => r.json())
    .then(data => {
      if (data.status === "healthy") {
        startStream();
      } else {
        showError("El sistema reporta estado degradado. Verifica el panel de Debug.");
      }
    })
    .catch(() => showError("No se puede contactar al backend. ¿Está corriendo en el puerto 8010?"));
</script>
