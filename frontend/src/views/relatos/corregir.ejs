<%
/*
 * Spec-610 §3.1 / §3.7.1 (D20): corregir el relato acto por acto.
 *
 * Variables: story, relato (con `repetition`), actos [{ number, name, text }],
 * lectura { palabras_por_minuto, episodio_minutos }, actoInicial.
 * La interacción (cambiar de acto, contar, guardar, avisos) es de corregir-relato.js.
 */
const estimate = locals.estimateLabels ? locals.estimateLabels.regenerate_voz : '';
%>
<div class="max-w-6xl mx-auto flex flex-col gap-6" data-corregir data-story-id="<%= story.id %>" data-narrative-id="<%= relato.id %>">
  <div class="flex flex-col gap-2">
    <a href="/historia/<%= story.id %>/relatos" class="text-sm text-forge-muted hover:text-forge-accent flex items-center gap-2 w-fit">
      <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver a los relatos
    </a>
    <h2 class="heading-forge-lg">Corregir el relato</h2>
    <p class="pista-forge"><i data-lucide="info"></i><span><%= relato.title || story.title %>. Lo que cambies se guarda solo y es lo que se lee en el video.</span></p>
  </div>

  <section class="card-forge !p-5 flex flex-col gap-2" aria-label="Duración del episodio" data-duracion>
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
      <span class="font-serif text-2xl tabular-nums" data-duracion-total></span>
      <span class="text-sm text-forge-muted tabular-nums" data-duracion-palabras></span>
      <span data-duracion-estado></span>
    </div>
    <div class="relative h-7" data-duracion-regla aria-hidden="true"></div>
  </section>

  <% if (!actos.length) { %>
    <p class="nota-forge nota-forge--info"><i data-lucide="info" class="nota-forge__icono"></i><span>Este relato no está separado en actos, así que no se puede corregir acá.</span></p>
  <% } else { %>
  <div class="grid gap-4 lg:grid-cols-[13rem_minmax(0,1fr)_15rem] items-start">
    <nav class="card-forge !p-2 flex lg:flex-col gap-1 overflow-x-auto" aria-label="Actos">
      <% actos.forEach((acto) => { %>
        <button type="button" class="corregir-acto text-left rounded-lg px-3 py-2 min-w-[9rem] lg:min-w-0" data-acto-tab="<%= acto.number %>" aria-current="<%= acto.number === actoInicial %>">
          <span class="block text-sm font-medium"><%= acto.number %> · <%= acto.name %></span>
          <span class="block text-xs tabular-nums opacity-80" data-acto-resumen="<%= acto.number %>"></span>
        </button>
      <% }) %>
    </nav>

    <div class="min-w-0">
      <% actos.forEach((acto, i) => { %>
        <section class="card-forge !p-5 flex flex-col gap-4" data-acto-panel="<%= acto.number %>" <%= acto.number === actoInicial ? '' : 'hidden' %>>
          <h3 class="font-serif text-2xl text-forge-accent">Acto <%= acto.number %> · <%= acto.name %></h3>
          <% if (i > 0) { %>
            <p class="font-serif italic text-forge-muted border-l-2 border-forge-border pl-3" data-anterior="<%= acto.number %>"></p>
          <% } %>
          <% if ((story.stale_acts || []).includes(acto.number)) { %>
            <p class="nota-forge nota-forge--info"><i data-lucide="history" class="nota-forge__icono"></i><span>Este acto se escribió antes de que regeneraras un acto anterior: puede no seguir los cambios.</span></p>
          <% } %>
          <label class="sr-only" for="acto-texto-<%= acto.number %>">Texto del acto <%= acto.number %></label>
          <textarea id="acto-texto-<%= acto.number %>" class="prose-forge w-full min-h-[26rem] rounded-lg border border-forge-border bg-forge-bg px-4 py-3 resize-y" spellcheck="true" data-acto-texto="<%= acto.number %>"><%= acto.text %></textarea>
          <div class="flex flex-wrap justify-between gap-2 pt-3 border-t border-forge-border">
            <% const prev = actos[i - 1]; const next = actos[i + 1]; %>
            <% if (prev) { %><button type="button" class="btn-forge-outline-sm" data-acto-tab="<%= prev.number %>"><i data-lucide="arrow-left" class="w-4 h-4"></i> <%= prev.name %></button><% } else { %><span></span><% } %>
            <% if (next) { %><button type="button" class="btn-forge-outline-sm" data-acto-tab="<%= next.number %>"><%= next.name %> <i data-lucide="arrow-right" class="w-4 h-4"></i></button><% } %>
          </div>
        </section>
      <% }) %>
    </div>

    <aside class="flex flex-col gap-4">
      <% actos.forEach((acto) => { %>
        <section class="card-forge !p-4 flex flex-col gap-3 text-sm" data-acto-lado="<%= acto.number %>" <%= acto.number === actoInicial ? '' : 'hidden' %>>
          <span class="text-forge-muted-caps !tracking-[0.15em]">Este acto</span>
          <span class="tabular-nums" data-acto-medida="<%= acto.number %>"></span>
          <span class="text-forge-muted-caps !tracking-[0.15em]">Avisos</span>
          <div class="flex flex-col gap-2" data-avisos="<%= acto.number %>"></div>
          <span class="text-forge-muted-caps !tracking-[0.15em]">¿No te convence?</span>
          <% if (locals.otroLargo) { %>
            <%/* Spec-650 D11: versión del otro largo; el Core no la regenera por actos. */%>
            <p class="pista-forge" data-otro-largo><i data-lucide="info"></i>Esta versión se escribió cuando la historia tenía otro largo: se puede leer, corregir y descargar, pero para regenerar un acto hay que escribir la historia de nuevo.</p>
          <% } else { %>
          <button type="button" class="btn-forge-outline-sm w-fit" data-regenerar="<%= acto.number %>"
                  data-confirmar-titulo="¿Regenerar el acto <%= acto.number %>?"
                  data-detalle="<%= estimate ? `Tarda ${estimate}. ` : '' %>La IA lo escribe de nuevo y se pierde lo que corregiste en este acto.">
            <i data-lucide="refresh-cw" class="w-4 h-4"></i> Regenerar el acto
          </button>
          <p class="pista-forge hidden" data-regenerando="<%= acto.number %>"><i data-lucide="loader" class="animate-spin"></i><span>Regenerando… se actualiza sola al terminar.</span></p>
          <% } %>
        </section>
      <% }) %>
    </aside>
  </div>
  <% } %>

  <%- include('../asistente/_guardado') %>
</div>
<script type="application/json" id="corregir-datos"><%- JSON.stringify({ repetition: relato.repetition, lectura, actoInicial }).replace(/</g, '\\u003c') %></script>
<script src="/js/tiempos.js?v=<%= locals.assetVersion || '' %>"></script>
<script src="/js/guardado.js?v=<%= locals.assetVersion || '' %>"></script>
<script src="/js/corregir-relato.js?v=<%= locals.assetVersion || '' %>"></script>
