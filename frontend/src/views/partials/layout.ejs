<% const environment = locals.environment || { isDev: false }; -%>
<!DOCTYPE html>
<html lang="es"<%- environment.isDev ? ' data-env="dev"' : '' %>>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%/* Spec-550 H3: el menú colapsado se aplica antes de pintar (sin parpadeo). */%>
  <script>try { if (localStorage.getItem("forge:sidebar") === "collapsed") document.documentElement.dataset.sidebar = "collapsed"; } catch (e) {}</script>
  <title><%= environment.isDev ? '[DEV] ' : '' %>NarrativeForge — <%= title %></title>

  <%/* Spec-531: favicon (vela) + color de la barra del navegador en móviles.
       Spec-540: en dev, la vela y el color del tema «Latte». */%>
  <% if (environment.isDev) { %>
  <link rel="icon" href="/favicon-dev.svg" type="image/svg+xml">
  <meta name="theme-color" content="#eff1f5">
  <% } else { %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#f7f3ec">
  <% } %>

  <!-- CSS compilado (Tailwind CLI compilado con PostCSS) — Offline first -->
  <link rel="stylesheet" href="/styles.css?v=<%= locals.assetVersion || '' %>">
  <%/* Spec-630 B17: si una navegación con hx-boost trae otra versión, se carga la página entera. */%>
  <meta name="asset-version" content="<%= locals.assetVersion || '' %>">
  <script src="/js/version-check.js?v=<%= locals.assetVersion || '' %>"></script>

  <script src="https://unpkg.com/htmx.org@1.9.10"></script>
  <%/* Spec-460: canal global de eventos + componentes que lo consumen. En <head>
       con defer: sobreviven a las navegaciones de hx-boost (1 SSE por pestaña). */%>
  <script src="/js/event-bus.js?v=<%= locals.assetVersion || '' %>" defer></script>
  <script src="/js/eta.js?v=<%= locals.assetVersion || '' %>" defer></script>
  <script src="/js/generation-banner.js?v=<%= locals.assetVersion || '' %>" defer></script>
  <script src="/js/footer.js?v=<%= locals.assetVersion || '' %>" defer></script>
  <script src="/js/sidebar.js?v=<%= locals.assetVersion || '' %>" defer></script>
  <script src="/js/confirm-dialog.js?v=<%= locals.assetVersion || '' %>" defer></script>
  <script src="/js/generation-guard.js?v=<%= locals.assetVersion || '' %>" defer></script>
  <script src="/js/escribir-relato.js?v=<%= locals.assetVersion || '' %>" defer></script>

  <style>
    body { font-size: 1.125rem; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--forge-bg); }
    ::-webkit-scrollbar-thumb { background: var(--forge-accent); border-radius: 3px; }
  </style>
</head>
<body class="flex h-screen overflow-hidden font-sans bg-forge-bg text-forge-text" hx-boost="true">

  <%- include('sidebar', { activePage }) %>

  <main class="flex-1 overflow-y-auto p-12 pb-24">
    <%- include('generation_banner') %>
    <%- body %>
  </main>

  <%- include('footer') %>
  <%- include('confirm_dialog') %>

  <% if (typeof flashMsg !== 'undefined' && flashMsg) { %>
  <div id="toast-notification"
       class="fixed top-6 right-6 z-50 flex items-center gap-3 px-5 py-3 border shadow-lg text-sm font-medium transition-opacity duration-500
              <%= flashType === 'error' ? 'bg-forge-surface border-forge-error-border text-forge-error' : 'bg-forge-surface border-forge-accent text-forge-accent' %>">
    <i data-lucide="<%= flashType === 'error' ? 'x-circle' : 'check-circle' %>" class="w-4 h-4 shrink-0"></i>
    <span><%= flashMsg %></span>
  </div>
  <script>
    (function() {
      const t = document.getElementById('toast-notification');
      if (!t) return;
      setTimeout(function() { t.style.opacity = '0'; }, 3000);
      setTimeout(function() { t.remove(); }, 3500);
    })();
  </script>
  <% } %>

  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script>
    lucide.createIcons();

    // Autofocus al primer campo del formulario
    function focusFirstField() {
      const firstField = document.querySelector('form input:not([type="hidden"]), form textarea, form select');
      if (firstField) {
        firstField.focus();
      }
    }

    // Ejecutar al cargar la página
    document.addEventListener('DOMContentLoaded', focusFirstField);

    // Ejecutar después de swaps de HTMX (si se usa en el proyecto)
    document.addEventListener('htmx:afterSwap', focusFirstField);
    document.addEventListener('htmx:afterSettle', () => { lucide.createIcons(); });
  </script>
</body>
</html>
