<%
/*
 * Variables de entrada:
 *   activePage:  string — 'home' | 'generate' | 'gallery' | 'debug' | 'components'
 *   environment: (opcional) Spec-540 — { isDev, branch, commit }; sin él, prod.
 */
const environment = locals.environment || { isDev: false };
const navItems = [
  { page: 'home',       href: '/',           icon: 'home',         label: 'Inicio'      },
  { page: 'generate',   href: '/nuevo',      icon: 'pen-line',     label: 'Nuevo relato'     },
  { page: 'gallery',    href: '/galeria',    icon: 'library',      label: 'Galería de historias' },
  { page: 'debug',      href: '/debug',      icon: 'terminal',     label: 'API conn' },
  ];
%>
<aside class="w-[var(--sidebar-width)] flex-shrink-0 flex flex-col border-r border-forge-border bg-forge-surface">

  <div class="px-5 py-6 border-b border-forge-border">
    <span class="text-forge-accent font-serif text-lg tracking-widest uppercase">Narrative</span>
    <span class="flex items-center gap-2 text-forge-muted text-xs tracking-widest">Forge
      <% if (environment.isDev) { %><span class="px-1.5 py-0.5 rounded bg-forge-accent text-forge-on-accent font-bold tracking-wider" data-env-badge>DEV</span><% } %>
    </span>
  </div>

  <nav class="flex-1 py-4">
    <% navItems.forEach(item => { %>
      <%
        const isActive = activePage === item.page;
        const stateCls = isActive ? 'nav-link-forge-active' : 'nav-link-forge-idle';
      %>
      <a href="<%= item.href %>" class="nav-link-forge <%= stateCls %>">
        <i data-lucide="<%= item.icon %>" class="w-4 h-4 flex-shrink-0"></i>
        <%= item.label %>
        <% if (item.page === 'generate') { %>
          <%/* Spec-460: punto pulsante mientras hay generaciones en curso */%>
          <span data-forge-jobs-dot title="Hay una generación en curso"
                class="hidden ml-auto generation-banner__pulse !w-2 !h-2"></span>
        <% } %>
      </a>
    <% }); %>
  </nav>

  <div class="px-5 py-3 text-xs text-forge-muted" data-env-version>
    <% if (environment.isDev) { %>
      <%/* Spec-540: qué se está mirando en dev. */%>
      <span class="font-bold text-forge-accent">DEV</span> · <%= environment.branch || 'sin git' %><% if (environment.commit) { %> · <code><%= environment.commit %></code><% } %>
    <% } else { %>
      v0.3.0 — Slice 3
    <% } %>
  </div>
</aside>
