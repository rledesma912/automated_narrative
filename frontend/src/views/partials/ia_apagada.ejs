<%/*
  Spec-740 C6: la historia es de un largo deshabilitado (sin crédito para la IA del largo).
  Entrada: x = el estado del asistente o la historia (con ia_disponible, ia_nota y, para
  ofrecer el cambio de largo, story_id). No muestra nada si hay IA.
*/%>
<% const ia = locals.x || {}; %>
<% if (ia.ia_disponible === false) { %>
  <div class="nota-forge nota-forge--info" role="status" data-ia-apagada-nota>
    <i data-lucide="info" class="nota-forge__icono"></i>
    <p class="flex-1"><%= ia.ia_nota %> Podés leer y corregir esta historia a mano, o pasarla a otro largo.</p>
    <% if (ia.story_id) { %>
      <a class="nota-forge__accion" href="/asistente/<%= ia.story_id %>/direccion#largo">Cambiar el largo</a>
    <% } %>
  </div>
<% } %>
