<%
/*
 * Panel de un relato individual (extraído de relatos.ejs — Spec-430).
 * Se usa tanto en el render inicial (dentro del loop de relatos.ejs) como
 * standalone al regenerar un acto (swap HTMX del <section> completo).
 *
 * Variables de entrada:
 *   story: { id, ... }
 *   relato: { id, content, title, created_at, ... }
 *   isActive: boolean
 *   regenerating: { acto, jobId } | null — acto re-narrándose como job (Spec-460 S7)
 *   panelError: string | null — error al lanzar o completar la regeneración
 */
const regen = (typeof regenerating !== 'undefined' && regenerating) ? regenerating : null;
// Spec-510: «Tarda ≈ N min» en la confirmación (lo deja el middleware loadEstimates).
const regenEstimate = locals.estimateLabels ? locals.estimateLabels.regenerate_voz : '';
// Spec-610: cuánto tarda armar el guion para el video.
const guionEstimate = locals.estimateLabels ? (locals.estimateLabels.video_script || '') : '';
const errorMsg = (typeof panelError !== 'undefined' && panelError) ? panelError : null;
const sections = (relato.content || '').split(/^## (.+)$/m);
const preamble = (sections[0] || '').trim();

function mapBeatTitle(title) {
  const match = title.match(/Beat\s*(\d+)/i);
  if (match) return `Acto ${match[1]}`;
  return title;
}

function extractActNumber(title) {
  const match = title.match(/(\d+)/);
  return match ? match[1] : '';
}
%>
<section
  id="relato-panel-<%= relato.id %>"
  data-relato-panel="<%= relato.id %>"
  class="relato-panel card-forge !p-8 max-h-[calc(100vh-16rem)] overflow-y-auto <%= isActive ? 'active' : 'hidden' %>"
>
  <%/* Spec-630 B13: sin encabezado (repetía el título de la historia). */%>
  <div class="flex items-center justify-end gap-4 mb-6 flex-wrap">
    <div class="flex items-center gap-3">
      <%/* Spec-490: .md para el TTS; sin hx-boost (htmx convertiría la descarga en un swap). Se deshabilita mientras se regenera un acto. */%>
      <a
        <% if (regen) { %>aria-disabled="true"<% } else { %>href="/api/v1/generated-narratives/<%= relato.id %>/export.md" download<% } %>
        data-descargar-relato="<%= relato.id %>"
        hx-boost="false"
        class="btn-forge-outline-sm <%= regen ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer' %>"
      >
        <i data-lucide="download" class="w-4 h-4"></i>
        Descargar .md
      </a>
      <%/* Spec-610: corregir el relato en la web (un acto a la vez). */%>
      <a
        <% if (regen) { %>aria-disabled="true"<% } else { %>href="/historia/<%= story.id %>/relatos/<%= relato.id %>/corregir"<% } %>
        data-corregir-relato="<%= relato.id %>"
        class="btn-forge-outline-sm <%= regen ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer' %>"
      >
        <i data-lucide="pencil" class="w-4 h-4"></i>
        Corregir el relato
      </a>
      <%/* Spec-610: el paquete para el video (guion, la calabaza y el mapa). */%>
      <% if (relato.hasVideoScript) { %>
        <a href="/historia/<%= story.id %>/relatos/<%= relato.id %>/video" class="btn-forge-sm cursor-pointer" data-para-el-video="<%= relato.id %>">
          <i data-lucide="clapperboard" class="w-4 h-4"></i>
          Para el video
        </a>
      <% } else { %>
        <button type="button" class="btn-forge-sm cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" <%= regen ? 'disabled' : '' %>
                data-armar-guion="<%= relato.id %>" data-story-id="<%= story.id %>"
                data-detalle="<%= guionEstimate ? `Tarda ${guionEstimate}. ` : '' %>La IA reparte el relato en bloques para leer, escribe lo que dice la calabaza y arma lo que va en pantalla. El relato no cambia.">
          <i data-lucide="clapperboard" class="w-4 h-4"></i>
          Armar el guion para el video
        </button>
      <% } %>
      <button
        type="button"
        onclick="copyRelatoContent('<%= relato.id %>', this)"
        class="btn-forge-outline-sm cursor-pointer"
      >
        <i data-lucide="copy" class="w-4 h-4"></i>
        Copiar Relato
      </button>
    </div>
  </div>
  <% if (regen) { %>
    <%/* Se recarga solo cuando termina el job (generation-guard.js). */%>
    <div role="status" aria-live="polite"
         class="flex items-center gap-3 mb-6 px-4 py-3 border border-forge-accent text-sm text-forge-text"
         data-refresh-on-job="<%= regen.jobId %>"
         data-refresh-url="/historia/<%= story.id %>/relatos/<%= relato.id %>/panel"
         data-refresh-target="#relato-panel-<%= relato.id %>">
      <span class="generation-banner__pulse" aria-hidden="true"></span>
      Regenerando el acto <%= regen.acto %>… el relato se actualiza solo al terminar.
    </div>
  <% } %>
  <p class="hidden nota-forge nota-forge--error mb-6" role="alert" data-guion-error="<%= relato.id %>"></p>
  <% if (errorMsg) { %>
    <div role="alert" class="nota-forge nota-forge--error mb-6">
      <i data-lucide="x-circle" class="nota-forge__icono"></i>
      <span data-panel-error><%= errorMsg %></span>
    </div>
  <% } %>
  <div id="relato-content-<%= relato.id %>" class="text-forge-text">
    <% if (preamble) { %>
      <div class="prose-forge whitespace-pre-wrap" data-copy-part><%= preamble %></div>
    <% } %>
    <% for (let i = 1; i < sections.length; i += 2) { %>
      <% const actNumber = extractActNumber(sections[i]); %>
      <div class="flex items-center justify-between gap-3 <%= i === 1 && !preamble ? 'mt-0' : 'mt-10' %> mb-4">
        <h3 class="heading-forge-lg !text-2xl !text-forge-accent !mt-0 !mb-0" data-copy-part><%= mapBeatTitle(sections[i]) %></h3>
        <% if (actNumber) { %>
          <button
            type="button"
            class="btn-forge-outline !text-xs !py-1 !px-2 shrink-0 disabled:opacity-40 disabled:cursor-not-allowed"
            <%= regen ? 'disabled' : '' %>
            data-regenerar-acto="<%= actNumber %>"
            hx-disabled-elt="this"
            hx-post="/historia/<%= story.id %>/relatos/<%= relato.id %>/actos/<%= actNumber %>/regenerar"
            hx-target="#relato-panel-<%= relato.id %>"
            hx-swap="outerHTML"
            hx-confirm="<%= regenEstimate ? `Tarda ${regenEstimate}. ` : '' %>Se reemplaza el texto actual del acto <%= actNumber %>."
            data-confirmar-titulo="¿Regenerar el acto <%= actNumber %>?"
            data-confirmar-label="Regenerar el acto"
          >
            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Regenerar
          </button>
        <% } %>
      </div>
      <% if (isActive && (story.stale_acts || []).includes(Number(actNumber))) { %>
        <%/* Spec-560 A2: se regeneró un acto de antes; este siguió con la versión anterior. */%>
        <p class="nota-forge nota-forge--info mb-4" data-acto-desactualizado>
          <i data-lucide="history" class="nota-forge__icono"></i>
          <span>Este acto se escribió antes de que regeneraras un acto anterior: puede no seguir los cambios. Si querés que los siga, regeneralo.</span>
        </p>
      <% } %>
      <% const rep = relato.repetition && relato.repetition.acts.find((a) => a.number === Number(actNumber)); %>
      <% const names = (rep && rep.invented_names) || []; %>
      <% const cortadas = rep && rep.too_cut ? (rep.cut_count || 0) : 0; %>
      <% const dialogo = (rep && rep.dialogue) || 0; %>
      <% const resumen = rep ? [rep.repeated.length ? `repite ${rep.repeated.length} ${rep.repeated.length === 1 ? 'frase' : 'frases'} de actos anteriores` : '', rep.cliches.length ? `${rep.cliches.length} ${rep.cliches.length === 1 ? 'cliché' : 'clichés'}` : '', names.length ? `${names.length} ${names.length === 1 ? 'nombre inventado' : 'nombres inventados'}` : '', cortadas ? `${cortadas} oraciones cortadas` : '', dialogo ? `tiene diálogo` : ''].filter(Boolean).join(' · ') : ''; %>
      <% if (resumen) { %>
        <%/* Spec-530 §8.3: control de repetición (no se copia ni va al .md). */%>
        <%/* Spec-550 H9: nota; lo que se toca es el link «Ver detalle», no la caja. */%>
        <%/* Spec-590 F: oraciones cortadas (desde el 25 % del acto) y diálogo directo. */%>
        <details class="mb-4 nota-forge nota-forge--warning block group" data-repeticion>
          <summary class="list-none flex items-start gap-3">
            <i data-lucide="repeat" class="nota-forge__icono"></i>
            <span class="flex-1"><%= resumen.charAt(0).toUpperCase() + resumen.slice(1) %></span>
            <span class="nota-forge__accion cursor-pointer"><span class="group-open:hidden">Ver detalle</span><span class="hidden group-open:inline">Ocultar</span></span>
          </summary>
          <ul class="mt-2 ml-7 space-y-1 list-disc pl-4">
            <% rep.repeated.forEach((r) => { %><li>Repite <%= r %></li><% }) %>
            <% rep.cliches.forEach((c) => { %><li>Cliché: «<%= c %>»</li><% }) %>
            <% if (names.length) { %><li>Nombres que no están en la historia: <%= names.join(', ') %> (si no los querés, regenerá el acto)</li><% } %>
            <% if (cortadas) { %><li>Oraciones cortadas: <%= cortadas %> de este acto (<%= rep.cut_pct %> %), por ejemplo <%= (rep.cut_sentences || []).map((s) => `«${s}»`).join(', ') %>. Si molestan, regenerá el acto.</li><% } %>
            <% if (dialogo) { %><li>Diálogo: <%= dialogo %> <%= dialogo === 1 ? 'frase' : 'frases' %> con raya o entre comillas. Si no lo querés, regenerá el acto.</li><% } %>
          </ul>
        </details>
      <% } %>
      <div class="prose-forge whitespace-pre-wrap" data-copy-part><%= (sections[i + 1] || '').trim() %></div>
    <% } %>
  </div>
</section>
