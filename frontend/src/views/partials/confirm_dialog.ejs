<%/* Spec-550 H8: confirmación con el tema. La maneja /js/confirm-dialog.js. */%>
<dialog id="forge-confirm" class="confirm-forge" aria-labelledby="forge-confirm-titulo" aria-describedby="forge-confirm-mensaje">
  <div class="flex items-start gap-4 mb-6">
    <%/* Spec-660: el ícono según qué se confirma (`ask({ icon })`); por defecto, el aviso. */%>
    <span class="confirm-forge__icono" data-confirm-icono="aviso"><i data-lucide="alert-triangle" class="w-6 h-6"></i></span>
    <span class="confirm-forge__icono confirm-forge__icono--escribir" data-confirm-icono="escribir" hidden><i data-lucide="feather" class="w-6 h-6"></i></span>
    <span class="confirm-forge__icono confirm-forge__icono--borrar" data-confirm-icono="borrar" hidden><i data-lucide="trash-2" class="w-6 h-6"></i></span>
    <div>
      <h3 id="forge-confirm-titulo" class="font-serif text-xl mb-1" data-confirm-titulo></h3>
      <p id="forge-confirm-mensaje" class="text-forge-muted" data-confirm-mensaje></p>
    </div>
  </div>
  <div class="nota-forge nota-forge--info mb-6" data-confirm-nota hidden>
    <i data-lucide="info" class="nota-forge__icono"></i>
    <p class="leading-relaxed" data-confirm-nota-texto></p>
  </div>
  <div class="flex flex-wrap justify-end gap-3">
    <button type="button" class="btn-forge-outline-sm" data-confirm-cancelar>Cancelar</button>
    <button type="button" class="btn-forge-sm" data-confirm-aceptar>Confirmar</button>
  </div>
</dialog>
