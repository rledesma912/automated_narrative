<%/* ── Modal de Confirmación Genérico (HTMX) ── */%>
<div id="modal-container" 
     class="fixed inset-0 z-[100] flex items-center justify-center bg-black/80 animate-in fade-in duration-200">
  
  <div class="card-forge !p-8 max-w-md w-full mx-4 shadow-2xl !bg-forge-surface"
       hx-on="click: event.stopPropagation()">
    
    <div class="flex items-center gap-4 mb-6">
      <div class="p-3 bg-red-950/30 rounded-full">
        <i data-lucide="alert-triangle" class="w-8 h-8 text-red-500"></i>
      </div>
      <div>
        <h3 class="heading-forge-lg !text-xl !mb-0">¿Confirmar acción?</h3>
        <p class="text-forge-muted-caps !opacity-70 mt-1">Esta operación no se puede deshacer.</p>
      </div>
    </div>

    <p class="text-forge-body !text-base mb-8">
      <%= message %>
    </p>

    <div class="flex items-center justify-end gap-4">
      <button onclick="document.getElementById('modal-container').remove()"
              class="btn-forge-outline">
        Cancelar
      </button>
      
      <button hx-delete="<%= actionUrl %>"
              hx-target="body"
              hx-swap="outerHTML"
              hx-indicator="#modal-spinner"
              class="btn-forge-outline !bg-red-900 !text-red-100 !border-red-800 hover:!bg-red-800 flex items-center gap-2">
        <span id="modal-spinner" class="htmx-indicator"><i data-lucide="loader" class="w-4 h-4 animate-spin"></i></span>
        <%= confirmText || 'Eliminar' %>
      </button>
    </div>
  </div>
</div>

<script>
  lucide.createIcons();
  // Cerrar al hacer click fuera
  document.getElementById('modal-container').addEventListener('click', function(e) {
    if (e.target === this) this.remove();
  });
</script>
