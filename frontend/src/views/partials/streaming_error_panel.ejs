<%/* ── Streaming Error Panel ── */%>
<%/* Spec-550 H9: el error es una nota (barra lateral), con sus botones debajo. */%>
<div id="error-panel" class="hidden mt-8 nota-forge nota-forge--error flex-col !gap-4 p-6">
  <div class="flex items-center gap-3">
    <i data-lucide="alert-triangle" class="nota-forge__icono"></i>
    <span class="font-bold">Conexión interrumpida</span>
  </div>
  <p id="error-msg" class="text-base leading-relaxed"></p>
  <div class="flex gap-4 flex-wrap">
    <button onclick="retryStream()"
            class="btn-forge-sm">
      Reintentar
    </button>
    <button onclick="cancelGeneration()"
            class="btn-forge-danger">
      <i data-lucide="square" class="w-4 h-4 inline mr-2"></i> Detener generación
    </button>
    <a href="/galeria"
       class="btn-forge-outline">
      Ver galería
    </a>
  </div>
</div>