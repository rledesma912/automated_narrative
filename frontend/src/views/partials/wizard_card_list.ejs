<%/* ── Wizard Card List (Partial reutilizable para personajes/escenarios/reglas) ── */%>
<%
  const pfx = locals.prefix || '';
  const itemLabel = locals.itemLabel || 'ITEM';
  const maxCount = locals.maxCount || 5;
  const addHandler = locals.addHandler || 'addItem()';
  const deleteHandler = locals.deleteHandler || 'deleteItem';
  const iconAdd = locals.iconAdd || 'plus-circle';
  const idxList = locals.indices || [];
  const cardMap = locals.cards || {};
  const meta = locals.meta || {};
  const savedValues = locals.saved || {};
%>

<div class="card-forge !p-6 space-y-5" id="<%= pfx %>-group">
  <div class="border-b border-forge-border pb-3">
    <h3 class="text-forge-muted-caps font-bold"><%= meta.title %></h3>
    <p class="text-sm text-forge-muted mt-1"><%= meta.subtitle %></p>
  </div>

  <% idxList.forEach((idx, i) => { %>
    <%
      const isFirst = i === 0;
      const visible = isFirst || hasCardData(cardMap[idx]);
      const nameVal = savedValues[pfx + '_' + idx + '_name'] || '';
    %>
    <div id="<%= pfx %>-card-<%= idx %>"
         class="border border-forge-border p-4<%= visible ? '' : ' hidden' %>">
      <div class="flex items-center justify-between mb-4">
        <h4 class="text-forge-muted-caps font-bold"
            id="<%= pfx %>-label-<%= idx %>">
          <%= itemLabel %> <%= idx %><% if (nameVal) { %> — <%= esc(nameVal) %><% } %>
        </h4>
        <button type="button"
                onclick="<%= deleteHandler %>('<%= idx %>')"
                id="<%= pfx %>-delete-btn-<%= idx %>"
                class="text-forge-muted hover:text-forge-error transition-colors<%= isFirst ? ' invisible' : '' %>">
          <i data-lucide="trash-2" class="w-4 h-4"></i>
        </button>
      </div>
      <% cardMap[idx].forEach(field => { %>
        <%- fieldHtml(field) %>
      <% }); %>
    </div>
  <% }); %>

  <div class="flex items-center gap-4 pt-2">
    <button type="button" onclick="<%= addHandler %>"
            id="btn-add-<%= pfx %>"
            class="btn-forge-outline">
      <i data-lucide="<%= iconAdd %>" class="w-4 h-4"></i> Agregar <%= itemLabel.toLowerCase() %>
    </button>
    <span class="text-xs text-forge-muted hidden" id="msg-max-<%= pfx %>">Máximo <%= maxCount %> <%= itemLabel.toLowerCase() %>s</span>
  </div>
</div>