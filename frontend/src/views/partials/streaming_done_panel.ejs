<%/* ── Streaming Done Panel ── */%>
<div id="done-panel" class="hidden mt-8 border border-forge-border bg-forge-surface p-8 shadow-2xl animate-in zoom-in-95 duration-500">
  <div class="flex items-center gap-3 mb-6">
    <i data-lucide="check-circle" class="w-6 h-6 text-forge-success"></i>
    <span class="text-forge-success text-lg font-bold uppercase tracking-widest">¡Tu relato está listo!</span>
  </div>
  <p class="hidden -mt-3 mb-6 text-sm text-forge-muted" data-done-duration></p>
  <div class="flex flex-wrap gap-4">
    <%/* Spec-630 B12: sin ficha; lo que se quiere ver al terminar es el relato. */%>
    <a href="/historia/<%= storyId %>/relatos"
       class="btn-forge-sm">
      <i data-lucide="book-open" class="w-5 h-5"></i> Ver relato
    </a>
    <a href="/galeria"
       class="btn-forge-outline">
      <i data-lucide="library" class="w-5 h-5"></i> Ver Galería
    </a>
  </div>
</div>