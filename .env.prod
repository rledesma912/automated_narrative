# === 1. GENERAL ===
ENV=production
API_HOST=0.0.0.0:8010
PORT=3000

# === 2. LLM PROFILE OVERRIDE ===
# Los perfiles pre-configurados (provider + modelos + params por rol) viven en
# config/llm_core_definitions.yaml bajo la clave `profiles:`.
# Esta variable pisa el `active_profile:` de la YAML (útil para experimentación).
# Valores válidos: cualquier clave bajo `profiles:` del YAML.
LLM_PROFILE=gemini-cli

# === 3. OLLAMA ===
# Override del host de Ollama (útil para Docker: host.docker.internal)
# OLLAMA_HOST=http://localhost:11434

# === 4. SECRETS ===
#ANTHROPIC_API_KEY=your_api_key_here

# === 5. DATABASE ===
# Path relativo a ./data/ — compartido entre CLI (host) y API (Docker, vía volume mount).
DATABASE_URL=sqlite+aiosqlite:////app/data/prod/stories.db

# === 6. PATHS ===
INPUT_DIR=./input_stories
OUTPUT_DIR=/app/output_stories/prod
PROMPTS_DIR=./config/prompts_generation
BEATS_DEFINITION_FILE=config/llm_beats_definition.yaml

# === 7. PROMPT FILENAMES (dentro de PROMPTS_DIR) ===
PROMPT_FILE_SYSTEM=system.md
PROMPT_FILE_VOICE=voice.md
PROMPT_FILE_JOURNAL=journal.md
