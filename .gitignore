#Todos los archivos que no deben subirse al repositorio

node_modules

# Archivos de historia generadas
historias_generadas
historias_saneadas

# Carpeta de entrada (mantener carpeta, ignorar archivos)
input_stories/*
!input_stories/.gitkeep

# Logs (mantener carpeta, ignorar archivos)
logs/*
!logs/.gitkeep

# Carpeta de salida raíz (mantener carpeta, ignorar archivos)
output_stories/*
!output_stories/.gitkeep

# Carpeta de salida frontend (mantener carpeta, ignorar archivos)
frontend/output_stories/*
!frontend/output_stories/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/

# Databases
*.db
!input_stories/.gitkeep

# Testing & Linting
.coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / Build
dist/
build/
*.egg-info/

# Logs & Temp
*.log
*.tmp
*.bak
.DS_Store

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production